# Vhost de la boutique {{SLUG}} - genere par scripts/deploy/new-shop.sh.
# HTTP-only a la creation. Certbot ajoute automatiquement le bloc HTTPS
# (listen 443, ssl_certificate*, redirect 301) apres emission du certificat.
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}} www.{{DOMAIN}};

    client_max_body_size 50M;

    access_log /var/log/nginx/{{SLUG}}-access.log;
    error_log  /var/log/nginx/{{SLUG}}-error.log;

    # Uploads servis directement par Nginx (perf)
    location /uploads/ {
        alias /var/www/{{SLUG}}/public/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Assets statiques Next.js (long cache)
    location /_next/static/ {
        alias /var/www/{{SLUG}}/.next/static/;
        expires 365d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Reverse proxy vers Next.js sur le port dedie
    location / {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
