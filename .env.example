# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="mysql://root@localhost:3306/b2b_saas"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="<random_base64_string_min_32_chars>"
NEXTAUTH_URL="http://localhost:3000"

# ── Chiffrement (AES-256-GCM) ─────────────────────────────────────────────────
ENCRYPTION_KEY="<base64_32_bytes>"

# ── Serveur Next.js ───────────────────────────────────────────────────────────
PORT=3000
HOST=localhost

# Note : Stripe, SMTP, Easy-Express, PFS, Ankorstore, eFashion, Faire sont
# configurés uniquement dans Admin > Paramètres (chiffrés en BDD, un compte
# par tenant). La traduction automatique utilise les identifiants PFS —
# pas de clé séparée.
