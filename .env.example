# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="mysql://root@localhost:3306/b2b_saas"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="<random_base64_string_min_32_chars>"
NEXTAUTH_URL="http://localhost:3000"

# ── Chiffrement (AES-256-GCM) ─────────────────────────────────────────────────
ENCRYPTION_KEY="<base64_32_bytes>"

# ── Serveur Next.js ───────────────────────────────────────────────────────────
PORT=3000
HOST=localhost

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Note : la clé DeepL, la clé Easy-Express et les identifiants PFS / eFashion
