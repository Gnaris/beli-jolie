# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/dev-server.log
/dev-photos-hover.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp logs
.playwright-mcp/

# test results
/test-results/

# superpowers (brainstorm artifacts)
.superpowers/
docs/superpowers/

# uploads (fichiers utilisateurs)
/private/uploads/
/public/uploads/

# paquets de déploiement VPS (générés localement, ne pas committer)
/beli-jolie-vps.tar.gz
/beli-jolie-vps.zip

# dumps locaux, scripts de fake data, migrations one-shot — jamais en repo
/tmp-migration/

# scripts de déploiement locaux qui contiennent des secrets ou du contexte
# machine — les autres fichiers de scripts/deploy/ (multi-boutiques) sont
# versionnés.
/scripts/deploy/mount-vps.ps1
/scripts/deploy/mysql_init.sql
/scripts/deploy/nginx-beliandjolie.conf
# fichiers cachés (secrets, credentials, temp) et notes locales
/scripts/deploy/.*
/scripts/deploy/*.password
/scripts/deploy/*_password
/scripts/deploy/*.html
/scripts/deploy/*.local

# état local du script de test Ankorstore (id produit de test)
/scripts/.ankorstore-test-state.json

# verrou Claude Code
/.claude/scheduled_tasks.lock

# listes de références produit utilisées ponctuellement par les scripts de
# maintenance (re-push ciblé, restore-links, etc.) — données de travail
# locales, ne pas commit.
/refs-*.txt

# journal de suivi du renommage des produits (skill produits-nom) — vit
# uniquement sur le VPS et évolue à chaque session, ne jamais commit.
/data/

# diagnostic et cookies Faire (générés localement par les scripts de debug)
/.faire-cookies.txt
/scripts/.faire-debug.png
/scripts/.faire-docs-diag.html
/scripts/.faire-docs-diag.png
/scripts/.faire-product-dump.json

# Dumps prod tirés en local (multi-tenant test)
/dumps/

# Scripts de dev multi-tenant test (crawl agents + rapports)
/scripts/dev/multi-tenant-test/

# Sondes Ankorstore (outputs JSON de debug, régénérés à chaque run)
/scripts/.ankorstore-orders-probe/
/scripts/.ankorstore-orders-probe-run.log
