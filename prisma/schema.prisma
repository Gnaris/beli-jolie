// Prisma Schema
// Base de données MySQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Rôles utilisateur
// ─────────────────────────────────────────────
enum Role {
  ADMIN
  CLIENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClientDiscountType {
  PERCENT // remise en %
  AMOUNT // remise en €
}

enum ClientDiscountMode {
  PERMANENT // appliquée sur toutes les commandes
  THRESHOLD // appliquée quand le sous-total HT >= discountMinAmount
  NEXT_ORDER // appliquée uniquement sur la prochaine commande
}

model User {
  id                            String              @id @default(cuid())
  email                         String
  password                      String
  firstName                     String
  lastName                      String
  company                       String
  phone                         String
  siret                         String?
  businessRegistrationNumber    String? // N° d'enregistrement d'entreprise (clients hors France : Companies House, EIN, etc.)
  kbisPath                      String?
  documentPath                  String? // Document libre envoyé lors de l'inscription (justificatif d'entreprise hors UE)
  registrationMessage           String?             @db.Text // Message libre lors de l'inscription (Zod autorise 2000 caractères — VARCHAR(191) MySQL par défaut est trop court)
  // Adresse de la société (saisie à l'inscription)
  addressStreet                 String? // ex: "12 rue des Lilas"
  addressComplement             String? // ex: "Bâtiment B, 3e étage"
  addressZip                    String? // ex: "75011"
  addressCity                   String? // ex: "Paris"
  addressCountry                String? // code ISO-2 ex: "FR", "DE", "GP" (Guadeloupe), "US"
  vatNumber                     String? // Numéro TVA intracommunautaire (ex: FR12345678901)
  // Résultat VIES stocké à l'inscription (ou lors d'un re-check admin)
  viesValid                     Boolean?
  viesName                      String?
  viesAddress                   String?
  viesRequestDate               String?
  viesError                     String? // null = OK, sinon message d'erreur VIES
  // Exonération TVA validée manuellement par l'admin (UE hors France uniquement)
  vatExempt                     Boolean             @default(false)
  vatValidatedAt                DateTime?
  vatValidatedBy                String? // id de l'admin qui a validé
  stripeCustomerId              String? // cus_xxx — requis pour le virement bancaire
  // Consentement RGPD : englobe newsletter + relances panier abandonné (case
  // unique à l'inscription, cf. docs multi-tenant / mémoire projet).
  acceptsNewsletter             Boolean             @default(false)
  // Opt-out spécifique aux relances panier abandonné (case dans /espace-pro
  // + lien 1-clic dans le mail via abandonedCartOptOutToken). Prime sur
  // acceptsNewsletter : posé à true → aucun job créé + tous les jobs pending
  // annulés. Case séparée pour ne pas désinscrire de toutes les newsletters
  // quand le client veut juste couper les relances panier.
  abandonedCartOptOut           Boolean             @default(false)
  abandonedCartOptOutToken      String?             @unique // token 1-clic (nullable = lazy, généré au 1er envoi)
  // Opt-out spécifique aux relances inactivité (« On vous a pas vu depuis
  // X jours »). Miroir de abandonedCartOptOut : case séparée dans /espace-pro
  // + lien 1-clic dans le mail via inactiveClientOptOutToken. Prime sur
  // acceptsNewsletter : true → aucun envoi + job éventuel annulé.
  inactiveClientOptOut          Boolean             @default(false)
  inactiveClientOptOutToken     String?             @unique // token 1-clic (nullable = lazy, généré au 1er envoi)
  role                          Role                @default(CLIENT)
  status                        UserStatus          @default(PENDING)
  // Remise commerciale
  discountType                  ClientDiscountType? // null = pas de remise
  discountValue                 Decimal?            @db.Decimal(12, 2) // % ou montant €
  discountMode                  ClientDiscountMode? // null = PERMANENT (rétro-compat)
  discountMinAmount             Decimal?            @db.Decimal(12, 2) // seuil HT pour mode THRESHOLD
  discountMinQuantity           Int? // nombre min d'articles pour mode THRESHOLD
  discountNextOrderUsed         Boolean             @default(false) // true = remise NEXT_ORDER déjà utilisée
  freeShipping                  Boolean             @default(false) // livraison entièrement offerte (bascule 100% + case cochée)
  freeShippingMaxPrice          Decimal?            @db.Decimal(12, 2) // plafond HT du prix transporteur au-delà duquel on ne rembourse plus (null = pas de plafond)
  shippingDiscountType          ClientDiscountType? // PERCENT ou AMOUNT, null = pas de remise livraison
  shippingDiscountValue         Decimal?            @db.Decimal(12, 2) // valeur %, montant €
  shippingDiscountMode          ClientDiscountMode? // null = PERMANENT (rétro-compat)
  shippingDiscountMinAmount     Decimal?            @db.Decimal(12, 2) // seuil HT pour mode THRESHOLD
  shippingDiscountMinQuantity   Int? // nombre min d'articles pour mode THRESHOLD
  shippingDiscountNextOrderUsed Boolean             @default(false) // true = remise NEXT_ORDER déjà utilisée
  lastLoginAt                   DateTime?
  lastSeenAt                    DateTime? // Heartbeat: dernier ping reçu pendant que le client est sur le site
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  // Multi-tenant : nullable pendant la migration progressive, deviendra NOT NULL
  // une fois toutes les lignes existantes backfillées vers le tenant beli-jolie.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  cart                       Cart?
  addresses                  ShippingAddress[]
  orders                     Order[]
  favorites                  Favorite[]
  importDrafts               ImportDraft[]
  importJobs                 ImportJob[]
  stockMovements             StockMovement[]                  @relation("StockMovementCreator")
  conversations              Conversation[]
  messagesSent               Message[]
  claims                     Claim[]
  credits                    Credit[]
  promotionUsages            PromotionUsage[]
  productViews               ProductView[]                    @relation("ProductViewer")
  priceChanges               PriceHistory[]                   @relation("PriceChanger")
  adminClientCards           AdminClientCard[]                @relation("AdminCardCreator")
  adminCardPurchaseAdditions AdminClientCardProductPurchase[] @relation("AdminCardPurchaseAdder")
  microstoreOrders           MicrostoreOrder[]
  emailSends                 EmailSend[]
  abandonedCartJob           AbandonedCartJob?
  inactiveClientJob          InactiveClientJob?
  customerReview             CustomerReview?                  @relation("CustomerReviewAuthor")
  customerReviewsModerated   CustomerReview[]                 @relation("CustomerReviewModerator")

  @@unique([tenantId, email])
  @@unique([tenantId, siret])
  @@unique([tenantId, stripeCustomerId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Favoris
// ─────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([userId, productId])
  @@index([tenantId])
  @@index([userId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Fiches clients Admin
// Répertoire personnel des admins (fiches manuelles, séparées des vrais comptes User)
// ─────────────────────────────────────────────
model AdminClientCard {
  id          String  @id @default(cuid())
  createdById String?
  createdBy   User?   @relation("AdminCardCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Identité
  firstName String
  lastName  String
  company   String?
  siret     String?
  vatNumber String?

  // Contact
  email   String?
  phone   String?
  website String?
  address String? @db.Text // Legacy : ancien champ libre, conservé pour compat. UI utilise addressLine/postalCode/city/countryCode

  // Adresse structurée
  addressLine String? @db.Text // Rue, numéro, complément
  postalCode  String?
  city        String?
  countryCode String? // ISO 3166-1 alpha-2 (ex. "FR")

  // Marketplaces d'origine (multi-choix)
  hasPfs        Boolean @default(false)
  hasAnkorstore Boolean @default(false)
  hasEfashion   Boolean @default(false)
  hasFaire      Boolean @default(false)
  hasOrderchamp Boolean @default(false)
  hasMicrostore Boolean @default(false)
  hasPassage    Boolean @default(false)

  // Rattachement automatique aux commandes PFS.
  // Posé quand la fiche est créée/matchée par la synchro des commandes PFS.
  // Sert de clé rapide pour retrouver le client sur les cycles de sync suivants.
  pfsCustomerId           String?
  // Idem pour eFashion Paris (id_acheteur côté API GraphQL).
  efashionCustomerId      String?
  // Idem pour Ankorstore (retailer.id JSON:API — UUID).
  ankorstoreRetailerId    String?
  // Idem pour Faire (retailer_id — "r_xxxxx" ou UUID).
  faireRetailerId         String?
  // Idem pour Orderchamp (retailer.id GraphQL — Base64).
  orderchampRetailerId    String?
  // Idem pour Microstore (client_info.client_id, ex "10900").
  microstoreClientId      String?
  // Marqueur "fiche créée automatiquement par une synchro marketplace"
  // (valeurs : "PFS", "EFASHION", "ANKORSTORE", "FAIRE"…). Utilisé pour afficher le badge "Importé auto".
  importedFromMarketplace String?

  // Historique
  lastOrderAt       DateTime?
  lastMessageSentAt DateTime?

  // Remise sur commande
  orderDiscountType  ClientDiscountType? // null = pas de remise
  orderDiscountValue Decimal?            @db.Decimal(12, 2)

  // Remise sur livraison (FREE = livraison offerte, sinon PERCENT/AMOUNT)
  shippingFree          Boolean             @default(false)
  shippingDiscountType  ClientDiscountType?
  shippingDiscountValue Decimal?            @db.Decimal(12, 2)

  // Note libre
  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  pfsOrders        PfsOrder[]
  efashionOrders   EfashionOrder[]
  ankorstoreOrders AnkorstoreOrder[]
  faireOrders      FaireOrder[]
  orderchampOrders OrderchampOrder[]
  microstoreOrders MicrostoreOrder[]
  productPurchases AdminClientCardProductPurchase[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([createdById])
  @@index([tenantId, pfsCustomerId])
  @@index([tenantId, efashionCustomerId])
  @@index([tenantId, ankorstoreRetailerId])
  @@index([tenantId, faireRetailerId])
  @@index([tenantId, orderchampRetailerId])
  @@index([tenantId, microstoreClientId])
  @@index([tenantId, siret])
}

// ─────────────────────────────────────────────
// Produits achetés par un client — fiche admin
// Suivi par produit + couleur + provenance (PFS, EFASHION, ANKORSTORE,
// FAIRE, MICROSTORE, PASSAGE). Un même produit-couleur peut cumuler
// plusieurs provenances (une ligne par source).
// La quantité PFS est croisée avec le calcul auto issu de PfsOrderItem :
// on garde le max des deux (voir server actions).
// ─────────────────────────────────────────────
enum ClientCardProductPurchaseSource {
  PFS
  EFASHION
  ANKORSTORE
  FAIRE
  MICROSTORE
  PASSAGE
}

model AdminClientCardProductPurchase {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  adminClientCardId String
  adminClientCard   AdminClientCard @relation(fields: [adminClientCardId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productColorId String
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)

  source   ClientCardProductPurchaseSource
  quantity Int

  addedById String?
  addedBy   User?   @relation("AdminCardPurchaseAdder", fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, adminClientCardId, productId, productColorId, source])
  @@index([tenantId, adminClientCardId])
  @@index([tenantId, productId])
  @@index([tenantId, productColorId])
}

// ─────────────────────────────────────────────
// Commandes PFS (Paris Fashion Shop) — LECTURE SEULE
// Copie locale des commandes récupérées depuis PFS. Aucune modification n'est
// jamais renvoyée à PFS ; la source de vérité reste leur back-office.
// Séparé de `Order` (commandes boutique) pour éviter toute pollution des
// statistiques boutique et permettre un cycle de sync propre.
// ─────────────────────────────────────────────
enum PfsOrderStatus {
  NEW
  VALIDATED
  SENT
  CANCELLED
}

model PfsOrder {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pfsOrderId  String // "ord_27223a91..."
  orderNumber String // "PO#42759407"

  status       PfsOrderStatus
  createdAtPfs DateTime
  canceledAt   DateTime?

  totalHT           Decimal  @db.Decimal(12, 2)
  totalTTC          Decimal  @db.Decimal(12, 2)
  vatAmount         Decimal  @db.Decimal(12, 2)
  vatRate           Decimal  @db.Decimal(5, 2)
  totalWeight       Decimal? @db.Decimal(10, 3)
  totalOrderedQty   Int
  totalValidatedQty Int
  uniqueReferences  Int      @default(0)
  hasInvoice        Boolean  @default(false)
  hasCredit         Boolean  @default(false)
  carrier           String?
  paymentMethod     String?

  pfsCustomerId   String
  customerName    String
  customerShop    String?
  customerCountry String? // ISO 3166-1 alpha-2

  adminClientCardId String?
  adminClientCard   AdminClientCard? @relation(fields: [adminClientCardId], references: [id], onDelete: SetNull)

  statusTimelineJson Json?
  rawDetailJson      Json?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items PfsOrderItem[]

  @@unique([tenantId, pfsOrderId])
  @@index([tenantId, createdAtPfs])
  @@index([tenantId, status])
  @@index([tenantId, pfsCustomerId])
  @@index([adminClientCardId])
}

model PfsOrderItem {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pfsOrderId String
  pfsOrder   PfsOrder @relation(fields: [pfsOrderId], references: [id], onDelete: Cascade)

  pfsItemId            String // "ord_9942..." — id ligne
  pfsProductRef        String // "A1623E"
  pfsProductInternalId String? // "pro_..."
  pfsSku               String // "A1623E_GOLDEN_TU"

  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productColorId String?
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: SetNull)

  productSnapshotName String?
  colorLabelFr        String?
  colorCodePfs        String?
  sizeLabel           String?
  sizeDetails         String?

  itemType     String   @default("ITEM")
  qtyOrdered   Int
  qtyValidated Int
  unitPriceHT  Decimal  @db.Decimal(12, 2)
  totalPriceHT Decimal  @db.Decimal(12, 2)
  weight       Decimal? @db.Decimal(10, 3)

  // Timestamp de déduction du stock depuis cette ligne PFS. Null = pas encore décrémentée.
  // Renseigné par le bouton « Déduire stock PFS » de /admin/produits ; garantit l'idempotence
  // (ré-import PFS ne retentera pas la décrémentation).
  stockDeductedAt DateTime?

  // Timestamp d'exclusion manuelle depuis la modale de prévisualisation. Non-null =
  // l'admin a choisi « Ne pas déduire » pour le produit rattaché ; la ligne est
  // considérée comme définitivement traitée (n'apparaît plus dans la file, aucun
  // stock n'a été modifié). Action irréversible.
  stockDeductionExcludedAt DateTime?

  createdAt DateTime @default(now())

  @@index([pfsOrderId])
  @@index([tenantId, productId])
  @@index([tenantId, pfsProductRef])
  @@index([tenantId, stockDeductedAt])
  @@index([tenantId, stockDeductionExcludedAt])
}

// ─────────────────────────────────────────────
// Commandes eFashion Paris — LECTURE SEULE
// Copie locale des commandes récupérées depuis wapi.efashion-paris.com/graphql.
// Même logique que PfsOrder : jamais renvoyée à eFashion, source de vérité = leur back-office.
// Table séparée de PfsOrder pour préserver les champs propres à eFashion (groupage,
// dimensions colis, tracking, remises multiples). La fusion avec PFS pour la page
// « Marketplaces » se fait applicativement.
// ─────────────────────────────────────────────
// Statut normalisé partagé PFS/eFashion pour permettre des filtres unifiés.
// Le statut brut eFashion (id_statut + libellé FR) reste stocké séparément.
enum EfashionOrderStatus {
  NEW // Nouvelle / en attente
  VALIDATED // « Confirmé » côté eFashion (validée, avant expédition)
  SHIPPED // Expédiée (statut 2 ou 8 côté eFashion)
  CANCELLED
}

model EfashionOrder {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ID commande eFashion (int côté API, stocké en string pour homogénéité avec PFS)
  efashionOrderId     String // "10618644"
  efashionOrderName   String // "F5647C490444A158967V2017"
  efashionOrderGroupe String? // "490444"

  status            EfashionOrderStatus
  statusIdRaw       Int // 2, 8, etc. — id_statut brut eFashion
  statusLabelFr     String // "Pickup colis effectué"
  createdAtEfashion DateTime // dateCreation / dateCommande
  shippedAt         DateTime?
  canceledAt        DateTime?

  // Montants HT (eFashion travaille en HT sur les commandes vendeur)
  totalHT            Decimal  @db.Decimal(12, 2) // montantTotal
  totalAfterDiscount Decimal  @db.Decimal(12, 2) // montantApresRemise
  ruptureHT          Decimal  @default(0) @db.Decimal(12, 2) // montantRuptureHT
  ca                 Decimal  @default(0) @db.Decimal(12, 2) // montantCA
  shippingCost       Decimal? @db.Decimal(12, 2) // frais_port
  totalWeight        Decimal? @db.Decimal(10, 3) // poids
  parcelCount        Int      @default(1) // nb_colis
  isFirstOrder       Boolean  @default(false)

  carrier       String? // livraison.libelle
  paymentMethod String? // paiement.texte_fr

  // Client eFashion — id_acheteur
  efashionCustomerId String
  customerName       String // nomSociete
  customerContact    String? // "Prénom Nom"
  customerEmail      String?
  customerVatIntra   String?
  customerEori       String?
  customerCountry    String? // ISO 3166-1 alpha-2 (adresse livraison)

  // Rattachement fiche client admin — même mécanique que PfsOrder
  adminClientCardId String?
  adminClientCard   AdminClientCard? @relation(fields: [adminClientCardId], references: [id], onDelete: SetNull)

  // Suivi expédition (recuperé via commandeEtiquettes)
  trackingNumber String?
  labelUrl       String?

  // Payload brut de commandeById pour drawer et debug
  rawDetailJson Json?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items EfashionOrderItem[]

  @@unique([tenantId, efashionOrderId])
  @@index([tenantId, createdAtEfashion])
  @@index([tenantId, status])
  @@index([tenantId, efashionCustomerId])
  @@index([adminClientCardId])
}

model EfashionOrderItem {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  efashionOrderId String
  efashionOrder   EfashionOrder @relation(fields: [efashionOrderId], references: [id], onDelete: Cascade)

  // Identifiants ligne eFashion
  efashionLineId    BigInt // id_ligne (14535554)
  efashionProductId Int // id_produit (3765459) — rattachement 1-1 avec ProductColor.efashionProductId
  efashionColorId   Int? // id_couleur (16)
  referenceFull     String // "A257-BLANC"
  referenceBase     String // "A257"

  // Rattachement BJ (résolution best-effort via ProductColor.efashionProductId ou reference_base)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productColorId String?
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: SetNull)

  // Snapshot au moment de la commande (résistant au renommage produit)
  productSnapshotName String?
  colorLabelFr        String? // couleur_FR
  categorySnapshot    String? // categorie
  provenanceCode      String? // provenance_code (ex "CN")

  // Quantités : eFashion découpe en 12 tailles max, on garde le JSON brut + le total
  qtyTotal         Int // quantite_total
  qtyPackUnit      Int // quantite_pack
  quantitiesJson   Json // {q1..q12}
  declinaisonsJson Json? // {d1_FR..d12_FR, d1_UK..d12_UK}

  // Prix HT
  unitPriceHT Decimal  @db.Decimal(12, 2) // prix
  totalLineHT Decimal  @db.Decimal(12, 2) // prixLigne
  weightUnit  Decimal? @db.Decimal(10, 3) // poids_produit
  weightLine  Decimal? @db.Decimal(10, 3) // poids

  // Déduction stock — même mécanique qu'à PFS pour idempotence
  stockDeductedAt DateTime?

  createdAt DateTime @default(now())

  @@index([efashionOrderId])
  @@index([tenantId, productId])
  @@index([tenantId, productColorId])
  @@index([tenantId, referenceBase])
  @@index([tenantId, efashionProductId])
  @@index([tenantId, stockDeductedAt])
}

// ─────────────────────────────────────────────
// Commandes Ankorstore — LECTURE SEULE
// Copie locale des commandes récupérées depuis /api/v1/orders (JSON:API).
// Même logique que PfsOrder / EfashionOrder : jamais renvoyée à Ankorstore,
// source de vérité = leur back-office. Table séparée pour préserver les champs
// propres à Ankorstore (masterOrderId, tracking Chronopost, brand_paid, etc.).
// ─────────────────────────────────────────────
// Statut normalisé partagé pour permettre des filtres unifiés.
// Le statut brut Ankorstore (statusRaw) reste stocké tel quel côté enregistrement.
enum AnkorstoreOrderStatus {
  NEW // submitted / needs_review / retailer_paid (en amont de la confirmation marque)
  VALIDATED // ankor_confirmed — commande confirmée, à préparer
  SHIPPED // shipped / delivered / brand_paid (post-expédition)
  CANCELLED // cancelled / rejected
}

model AnkorstoreOrder {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identifiants Ankorstore (UUID JSON:API)
  ankorstoreOrderId       String // "1f13aa03-94c6-60b0-9680-32b64ab4e5bc"
  ankorstoreMasterOrderId String? // master order (groupe multi-commandes)
  reference               String // numéro lisible ("4930569")

  status         AnkorstoreOrderStatus
  statusRaw      String // "brand_paid", "cancelled", "ankor_confirmed"…
  currency       String                @default("EUR")
  createdAtAnkor DateTime
  submittedAt    DateTime?
  shippedAt      DateTime?
  brandPaidAt    DateTime?
  canceledAt     DateTime?

  // Montants — Decimal en euros (après division /100 depuis les centimes API)
  brandNetAmount          Decimal @db.Decimal(12, 2) // HT net après frais Ankor
  brandTotalAmount        Decimal @db.Decimal(12, 2) // HT total commande
  brandTotalAmountVat     Decimal @db.Decimal(12, 2) // TVA
  brandTotalAmountWithVat Decimal @db.Decimal(12, 2) // TTC total commande

  // Motifs annulation / rejet (fournis quand pertinent)
  brandRejectReason                 String? @db.Text
  retailerRejectReason              String? @db.Text
  retailerCancellationRequestReason String? @db.Text

  // Adresse de facturation (attributs plats sur l'order Ankor)
  billingName             String?
  billingOrganisationName String?
  billingStreet           String?
  billingPostalCode       String?
  billingCity             String?
  billingCountryCode      String? // ISO 3166-1 alpha-2

  // Adresse de livraison (extraite de shippingOverview.shipToAddress)
  shippingName             String?
  shippingOrganisationName String?
  shippingStreet           String?
  shippingPostalCode       String?
  shippingCity             String?
  shippingCountryCode      String?

  // Transporteur + suivi
  shippingMethod        String? // "custom", "ankorstore", "no_shipping_needed"…
  carrier               String? // provider (chronopost, colissimo, dhl…)
  trackingNumber        String?
  trackingLink          String?   @db.Text
  trackingStatus        String? // DELIVERED, IN_TRANSIT…
  trackingStatusDetails String?
  trackingUpdatedAt     DateTime?

  // Retailer (client Ankorstore) — snapshot pour affichage sans re-query
  ankorstoreRetailerId String
  customerName         String // "Prénom Nom"
  customerShop         String? // storeName
  customerEmail        String?
  customerPhone        String?
  customerVatNumber    String?
  customerSiret        String? // businessIdentifier / taxNumber
  customerCountry      String? // ISO 3166-1 alpha-2 (adresse livraison)

  // Rattachement fiche client admin — même mécanique que PfsOrder / EfashionOrder
  adminClientCardId String?
  adminClientCard   AdminClientCard? @relation(fields: [adminClientCardId], references: [id], onDelete: SetNull)

  // Payloads bruts (drawer + debug)
  billingItemsJson     Json? // billing-items included (frais Ankor, shipping fees)
  shippingOverviewJson Json? // shippingOverview attribut détail (dates, quotes, parcels)
  rawDetailJson        Json? // payload complet du GET /orders/{id}

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items AnkorstoreOrderItem[]

  @@unique([tenantId, ankorstoreOrderId])
  @@index([tenantId, createdAtAnkor])
  @@index([tenantId, status])
  @@index([tenantId, ankorstoreRetailerId])
  @@index([adminClientCardId])
}

model AnkorstoreOrderItem {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ankorstoreOrderId String
  ankorstoreOrder   AnkorstoreOrder @relation(fields: [ankorstoreOrderId], references: [id], onDelete: Cascade)

  // Identifiants Ankorstore
  ankorstoreItemId    String // uuid order-item
  ankorstoreVariantId String? // uuid productVariant (si include résolu)
  ankorstoreProductId String? // uuid product (via variant.product)
  sku                 String // "PRT35_blanc_iz0dtf3t"
  referenceBase       String? // "PRT35" — premier segment du SKU, sert au matching catalogue

  // Rattachement BJ (résolution best-effort via Product.ankorsProductId,
  // ProductColor.ankorsVariantId, puis fallback Product.reference)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productColorId String?
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: SetNull)

  // Snapshot au moment de la commande (résistant au renommage)
  productSnapshotName String?
  variantOptionLabel  String? // couleur ou taille brute retournée par Ankor

  quantity           Int
  multipliedQuantity Int // quantity * unitMultiplier
  unitPriceHT        Decimal @db.Decimal(12, 2) // brandUnitPrice / 100
  totalPriceHT       Decimal @db.Decimal(12, 2) // brandAmount / 100
  vatAmount          Decimal @db.Decimal(12, 2) // brandAmountVat / 100
  totalWithVat       Decimal @db.Decimal(12, 2) // brandAmountWithVat / 100
  vatRate            Decimal @db.Decimal(5, 2)

  // Déduction stock — même mécanique qu'à PFS/eFashion pour idempotence
  stockDeductedAt DateTime?

  createdAt DateTime @default(now())

  @@index([ankorstoreOrderId])
  @@index([tenantId, productId])
  @@index([tenantId, productColorId])
  @@index([tenantId, referenceBase])
  @@index([tenantId, stockDeductedAt])
}

// ─────────────────────────────────────────────
// Commandes Faire — LECTURE SEULE
// Copie locale des commandes récupérées via GET /external-api/v2/orders.
// Même logique que les autres marketplaces (source de vérité = portail brand
// Faire). Faire NE FOURNIT PAS de webhook (confirmé 2026-06-15) → polling seul
// via faire-orders-worker (tick 5 min).
// ─────────────────────────────────────────────
// Statut normalisé partagé (unifié avec PFS/eFashion/Ankorstore).
// Le statut brut Faire ("NEW", "PROCESSING", "BACKORDERED"…) reste stocké
// dans `statusRaw`.
enum FaireOrderStatus {
  NEW // "NEW" / "PROCESSING" / "BACKORDERED" — à traiter par la marque
  SHIPPED // "SHIPPED" / "DELIVERED"
  CANCELLED
}

model FaireOrder {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  faireOrderId String // "bo_orderabc"
  displayId    String? // "ORD-12345"

  status      FaireOrderStatus
  statusRaw   String // "NEW"|"PROCESSING"|"BACKORDERED"|"SHIPPED"|"DELIVERED"|"CANCELLED"
  faireSource String? // "FAIRE" ou "FAIRE_DIRECT" (channel de vente)
  currency    String           @default("EUR")

  createdAtFaire DateTime
  updatedAtFaire DateTime?
  shipAfter      DateTime?
  shippedAt      DateTime?
  canceledAt     DateTime?

  // Montants HT (Faire tarifie en centimes, on convertit /100)
  totalHT          Decimal @db.Decimal(12, 2) // Σ price_cents × quantity
  commissionAmount Decimal @default(0) @db.Decimal(12, 2) // payout_costs.commission_cents/100
  payoutFeeAmount  Decimal @default(0) @db.Decimal(12, 2) // payout_costs.payout_fee_cents/100
  netAmount        Decimal @default(0) @db.Decimal(12, 2) // totalHT - commission - payout_fee

  // Adresse livraison (aplatie depuis `address`)
  shippingName        String?
  shippingCompany     String?
  shippingStreet      String?
  shippingStreet2     String?
  shippingCity        String?
  shippingStateCode   String?
  shippingPostalCode  String?
  shippingCountryCode String? // ISO 3166-1 alpha-2
  shippingPhone       String?

  // Retailer (client Faire) — snapshot pour affichage sans re-query
  faireRetailerId String
  customerName    String // address.name ou company_name
  customerShop    String? // address.company_name
  customerEmail   String?
  customerPhone   String?
  customerCountry String? // ISO alpha-2 (adresse livraison)

  // Rattachement fiche client admin — même mécanique que les autres marketplaces
  adminClientCardId String?
  adminClientCard   AdminClientCard? @relation(fields: [adminClientCardId], references: [id], onDelete: SetNull)

  // Suivi expédition (résultat POST /orders/{id}/shipments)
  carrier      String?
  trackingCode String?
  trackingUrl  String? @db.Text

  // Payload brut de GET /orders/{id} pour drawer + debug
  rawDetailJson Json?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items FaireOrderItem[]

  @@unique([tenantId, faireOrderId])
  @@index([tenantId, createdAtFaire])
  @@index([tenantId, status])
  @@index([tenantId, faireRetailerId])
  @@index([adminClientCardId])
}

model FaireOrderItem {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  faireOrderId String
  faireOrder   FaireOrder @relation(fields: [faireOrderId], references: [id], onDelete: Cascade)

  // Identifiants Faire
  faireItemId    String // "oi_1"
  faireProductId String? // "p_abc"
  faireVariantId String? // "po_456" (product_option_id)
  sku            String? // "BJ-BRC-001-OR-S"
  referenceBase  String? // segment produit extrait du SKU pour matching catalogue

  // Rattachement BJ (résolution via ProductColor.faireVariantId,
  // Product.faireProductId, puis fallback Product.reference == referenceBase)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productColorId String?
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: SetNull)

  // Snapshot au moment de la commande (résistant au renommage produit)
  productSnapshotName String? // product_name
  variantOptionLabel  String? // product_option_name (ex "Or / S")

  quantity     Int
  unitPriceHT  Decimal @db.Decimal(12, 2) // price_cents / 100
  totalPriceHT Decimal @db.Decimal(12, 2) // unitPriceHT × quantity

  includesTester Boolean @default(false)

  // Déduction stock — même mécanique qu'aux autres marketplaces pour idempotence
  stockDeductedAt DateTime?

  createdAt DateTime @default(now())

  @@index([faireOrderId])
  @@index([tenantId, productId])
  @@index([tenantId, productColorId])
  @@index([tenantId, referenceBase])
  @@index([tenantId, stockDeductedAt])
}

// ─────────────────────────────────────────────
// Orderchamp — marketplace B2B GraphQL (docs/orderchamp-integration.md)
// Miroir de la structure Faire — 1 commande + N items, snapshot rawDetailJson.
// Statut brut Orderchamp stocké dans `statusRaw`, normalisé dans `status`.
// ─────────────────────────────────────────────

enum OrderchampOrderStatus {
  NEW // Nouvelle commande à préparer
  SHIPPED // Expédiée / livrée
  CANCELLED // Annulée
}

model OrderchampOrder {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderchampOrderId String // ID GraphQL Orderchamp
  displayId         String? // Numéro visible acheteur

  status    OrderchampOrderStatus
  statusRaw String // Statut brut retourné par Orderchamp
  currency  String                @default("EUR")

  createdAtOrderchamp DateTime
  updatedAtOrderchamp DateTime?
  shipAfter           DateTime?
  shippedAt           DateTime?
  canceledAt          DateTime?

  // Montants HT (Orderchamp expose des montants décimaux, on stocke tel quel)
  totalHT          Decimal @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  payoutFeeAmount  Decimal @default(0) @db.Decimal(12, 2)
  netAmount        Decimal @default(0) @db.Decimal(12, 2)

  // Adresse livraison
  shippingName        String?
  shippingCompany     String?
  shippingStreet      String?
  shippingStreet2     String?
  shippingCity        String?
  shippingStateCode   String?
  shippingPostalCode  String?
  shippingCountryCode String? // ISO alpha-2
  shippingPhone       String?

  // Acheteur (retailer)
  orderchampRetailerId String
  customerName         String
  customerShop         String?
  customerEmail        String?
  customerPhone        String?
  customerCountry      String?

  adminClientCardId String?
  adminClientCard   AdminClientCard? @relation(fields: [adminClientCardId], references: [id], onDelete: SetNull)

  // Expédition
  carrier      String?
  trackingCode String?
  trackingUrl  String? @db.Text

  // Payload GraphQL brut pour debug + drawer détaillé
  rawDetailJson Json?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items OrderchampOrderItem[]

  @@unique([tenantId, orderchampOrderId])
  @@index([tenantId, createdAtOrderchamp])
  @@index([tenantId, status])
  @@index([tenantId, orderchampRetailerId])
  @@index([adminClientCardId])
}

model OrderchampOrderItem {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderchampOrderId String
  orderchampOrder   OrderchampOrder @relation(fields: [orderchampOrderId], references: [id], onDelete: Cascade)

  // Identifiants Orderchamp
  orderchampItemId    String // ID ligne côté API
  orderchampProductId String? // ID produit GraphQL
  orderchampVariantId String? // ID variante GraphQL
  sku                 String?
  referenceBase       String? // segment produit extrait du SKU pour matching catalogue

  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productColorId String?
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: SetNull)

  productSnapshotName String?
  variantOptionLabel  String?

  quantity     Int
  unitPriceHT  Decimal @db.Decimal(12, 2)
  totalPriceHT Decimal @db.Decimal(12, 2)

  includesTester Boolean @default(false)

  stockDeductedAt DateTime?

  createdAt DateTime @default(now())

  @@index([orderchampOrderId])
  @@index([tenantId, productId])
  @@index([tenantId, productColorId])
  @@index([tenantId, referenceBase])
  @@index([tenantId, stockDeductedAt])
}

// ─────────────────────────────────────────────
// Microstore (Dokkr) — commandes importées via QR-code session
// L'API Microstore n'a ni webhook ni push : on pull périodiquement via
// GET /order/new_view_all + GET /pluginsWeb/orderInfo/{id}.
// Les commandes sont marquées « déjà payées » à l'import (choix cliente).
// ─────────────────────────────────────────────

enum MicrostoreOrderStatus {
  NEW // Nouvelle commande, à préparer (goods_status=1, shipping_status=0)
  SHIPPED // Expédiée (shipping_status=all shipped)
  CANCELLED // Annulée côté Microstore
}

model MicrostoreOrder {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identifiant côté Microstore (doc_info.id — ex "1001026").
  microstoreOrderId String
  posNum            String? // doc_info.pos_num

  status    MicrostoreOrderStatus @default(NEW)
  statusRaw String // "shipping_status/goods_status" raw pour debug
  currency  String                @default("EUR")

  // Timestamps Microstore (ctime = Unix sec)
  createdAtMicrostore DateTime
  updatedAtMicrostore DateTime?
  shippedAt           DateTime?
  canceledAt          DateTime?

  // Montants
  totalHT       Decimal @db.Decimal(12, 2) // doc_info.total_price
  paidPrice     Decimal @default(0) @db.Decimal(12, 2)
  shippingPrice Decimal @default(0) @db.Decimal(12, 2)
  shippingLabel String? // doc_info.shipping_name (ex "Regrouper mes commandes / Group my orders")
  remark        String? @db.Text // Note laissée par le client sur Microstore
  invoiceTitle  String? // doc_info.invoice_title

  // Adresse livraison (aplatie depuis client_info)
  shippingName        String? // address_name (ex "Robin Rossignol")
  shippingCompany     String?
  shippingStreet      String? @db.Text
  shippingCity        String?
  shippingPostalCode  String?
  shippingCountryCode String? // ISO alpha-2 (mappé depuis "FRANCE"→"FR")
  shippingPhone       String?

  // Snapshot client
  microstoreClientId String? // client_info.client_id (Microstore internal ID)
  customerName       String
  customerCompany    String?
  customerEmail      String?
  customerPhone      String?
  customerCountry    String?
  customerVatNumber  String? // vat_num

  // Rattachement fiche client admin
  adminClientCardId String?
  adminClientCard   AdminClientCard? @relation(fields: [adminClientCardId], references: [id], onDelete: SetNull)

  // Rattachement User (créé automatiquement si l'email est nouveau)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Payload brut de GET /pluginsWeb/orderInfo/{id} pour debug et migration
  rawDetailJson Json?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items MicrostoreOrderItem[]

  @@unique([tenantId, microstoreOrderId])
  @@index([tenantId, createdAtMicrostore])
  @@index([tenantId, status])
  @@index([tenantId, microstoreClientId])
  @@index([adminClientCardId])
  @@index([userId])
}

model MicrostoreOrderItem {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  microstoreOrderInternalId String
  microstoreOrder           MicrostoreOrder @relation(fields: [microstoreOrderInternalId], references: [id], onDelete: Cascade)

  // Identifiants Microstore
  microstoreItemId    String // goods_info.id
  microstoreGoodsId   String? // goods_info.goods_id
  microstoreSkuId     String? // goods_info.sku_id
  itemRef             String // notre référence produit (ex "V346", "ZC22E") — matching principal
  goodsSn             String? // EAN 13 (ex "2039760012845")
  microstoreColorId   String? // goods_info.color_id
  colorNameSnapshot   String? // goods_info.color_name (ex "Doré", "Bleu")
  sizeNameSnapshot    String? // goods_info.size_name (souvent vide)
  productSnapshotName String? @db.Text // goods_info.name

  // Rattachement BJ (matching EAN puis fallback itemRef+color)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productColorId String?
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: SetNull)

  quantity     Int
  unitPriceHT  Decimal @db.Decimal(12, 2) // goods_info.price
  totalPriceHT Decimal @db.Decimal(12, 2) // goods_info.sale_sub_price

  imageUrl String? @db.Text // goods_info.img

  // Idempotence de déduction stock (comme les autres marketplaces)
  stockDeductedAt DateTime?

  createdAt DateTime @default(now())

  @@index([microstoreOrderInternalId])
  @@index([tenantId, productId])
  @@index([tenantId, productColorId])
  @@index([tenantId, itemRef])
  @@index([tenantId, stockDeductedAt])
}

// ─────────────────────────────────────────────
// Catalogue produits
// ─────────────────────────────────────────────

enum SaleType {
  UNIT // Vendu à l'unité
  PACK // Vendu par paquet de X unités
}

enum ProductStatus {
  OFFLINE // Hors ligne (brouillon / import terminé, à publier manuellement)
  ONLINE // En ligne (visible sur le catalogue public)
  ARCHIVED // Archivé (invisible, conservé pour historique commandes)
  SYNCING // Importation en cours (images en téléchargement depuis PFS)
}

// Catégorie principale (ex: Colliers, Bracelets)
model Category {
  id                         String                @id @default(cuid())
  name                       String
  slug                       String
  pfsCategoryId              String? // ID catégorie sur PFS (ex: "a045J000003KWwDQAW")
  pfsGender                  String? // Genre PFS : WOMAN | MAN | KID | SUPPLIES
  pfsFamilyId                String? // ID famille PFS (ex: "a035J00000185J7QAI")
  pfsFamilyName              String? // Nom lisible de la famille PFS (ex: "Bijoux_Fantaisie") — pour export Excel
  pfsCategoryName            String? // Nom catégorie PFS (ex: "Bagues", "Colliers") — colonne 4 de l'export Excel
  efashionCategorieId        Int?
  faireTaxonomyId            String?
  faireHsCode                String?
  // Mapping Orderchamp — 2 champs distincts :
  //   `orderchampCategoryPath` = enum `ProductCategoryPath` feuille (ex :
  //     "JEWELRY_ACCESSORIES_BRACELETS_BANGLE_BRACELETS"), sélectionné par
  //     l'admin dans /admin/categories. Envoyé en `category` sur publish.
  //   `orderchampCustomCategoryId` = ID GraphQL de la CustomCategory OC
  //     auto-créée à partir du nom de la catégorie BJ. Envoyé en
  //     `customCategory`. Auto-géré, pas d'action manuelle.
  orderchampCategoryPath     String?
  orderchampCustomCategoryId String?
  // Mapping Microstore : ID catégorie côté MC Gérant. Rempli manuellement via
  // CustomSelect dans CategoryEditorModal. Priorité sur matching par nom au push.
  microstoreCategoryId       Int?
  // Image ronde affichée sur la home + page /categories publique. Path public
  // servi par nginx (ex : `/uploads/{tenant}/categories/{id}/*.webp`). Null
  // → monogramme (première lettre majuscule) affiché en fallback.
  image                      String?
  position                   Int                   @default(0)
  // Contenu éditable de la page publique `/fr/categories/[slug]`. Tous facultatifs :
  // si vide, une trame par défaut est générée à partir du nom de la catégorie.
  seoTitle                   String?               @db.VarChar(255) // H1 + <title> (ex : "Grossiste blouses femme")
  seoIntro                   String?               @db.Text          // Paragraphe d'intro (positionnement, minimum, livraison)
  seoSecondary               String?               @db.Text          // Paragraphe secondaire (fabricants, tailles, saisons)
  seoFaq                     Json?                 // Tableau [{ q: string, a: string }, …]
  subCategories              SubCategory[]
  products                   Product[]
  translations               CategoryTranslation[]
  promotions                 PromotionCategory[]
  createdAt                  DateTime              @default(now())

  // Multi-tenant : lib scopée par tenant depuis 2026-07-12
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CategoryTranslation {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale       String
  name         String
  // Traductions des champs SEO de la page publique. Facultatif : si vide,
  // fallback trame par défaut (générée dans la locale demandée).
  seoTitle     String?  @db.VarChar(255)
  seoIntro     String?  @db.Text
  seoSecondary String?  @db.Text
  seoFaq       Json?
  createdAt    DateTime @default(now())

  @@unique([categoryId, locale])
}

// Sous-catégorie (ex: Sautoir, Jonc)
model SubCategory {
  id                         String                   @id @default(cuid())
  name                       String
  slug                       String
  categoryId                 String
  category                   Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products                   Product[]                @relation("ProductSubCategories")
  microstoreProducts         Product[]                @relation("ProductMicrostoreSubCategory")
  translations               SubCategoryTranslation[]
  // Orderchamp : customCategory enfant (créée auto avec parentId = OC ID de
  // la Category parente). Attribuée au produit à la place de la category
  // quand le produit BJ a au moins une sous-catégorie.
  orderchampCustomCategoryId String?
  // Orderchamp : feuille standard OC (enum `CategoryPath`, ex
  // "JEWELRY_ACCESSORIES_BRACELETS_BANGLE_BRACELETS"). Optionnel à ce niveau.
  // Résolution au publish : priorité aux sous-catégories mappées, sinon
  // fallback sur `Category.orderchampCategoryPath` (obligatoire pour publier).
  orderchampCategoryPath     String?
  // Mapping Microstore : ID catégorie côté MC Gérant. Obligatoire pour qu'une
  // sous-catégorie puisse être choisie comme étiquette Microstore d'un produit
  // (sinon le badge "M" reste grisé côté ProductForm et le push est refusé).
  microstoreCategoryId       Int?
  createdAt                  DateTime                 @default(now())

  // Multi-tenant : lib scopée par tenant depuis 2026-07-12
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([name, categoryId])
  @@index([tenantId])
}

// Cache des traductions FR des feuilles standard Orderchamp
// (`ProductCategoryPath` GraphQL enum). Global (l'enum OC est le même pour
// tous les tenants) — pas de scoping tenant. Peuplé en fond via l'API PFS
// translate au premier chargement de la page catégories, réutilisé ensuite.
model OrderchampCategoryTranslation {
  /// Path brut de l'enum OC, ex `JEWELRY_ACCESSORIES_BRACELETS_BANGLE_BRACELETS`.
  path      String   @id
  /// Libellé prettifié FR complet ("Bijoux Accessoires › Bracelets › Joncs").
  labelFr   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategoryTranslation {
  id            String      @id @default(cuid())
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  locale        String
  name          String
  createdAt     DateTime    @default(now())

  @@unique([subCategoryId, locale])
}

// Bibliothèque de couleurs réutilisables entre produits (scopée par tenant)
model Color {
  id                 String              @id @default(cuid())
  name               String
  hex                String?
  patternImage       String?
  pfsColorRef        String?
  efashionColorId    Int?
  // Mapping Microstore : ID de la couleur équivalente côté MC Gérant.
  // Rempli manuellement via le CustomSelect « Correspondance Microstore » dans
  // ColorEditorModal. Priorité sur le matching par nom au moment du push produit.
  microstoreColorId  Int?
  position           Int                 @default(0)
  createdAt          DateTime            @default(now())
  productColors      ProductColor[]
  colorImages        ProductColorImage[]
  translations       ColorTranslation[]
  packLineUsages     PackColorLine[]
  primaryForProducts Product[]           @relation("ProductPrimaryColor")

  // Multi-tenant : lib scopée par tenant depuis 2026-07-12
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ColorTranslation {
  id        String   @id @default(cuid())
  colorId   String
  color     Color    @relation(fields: [colorId], references: [id], onDelete: Cascade)
  locale    String
  name      String
  createdAt DateTime @default(now())

  @@unique([colorId, locale])
}

// Bibliothèque des codes SH (Système Harmonisé / code douanier)
// Numéro à 6-10 chiffres + libellé court FR.
model HsCode {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String
  // Format Faire (avec points, ex: "7117.19.00.00"). Optionnel — si null,
  // le code numérique brut sert de fallback lors de l'envoi à Faire.
  faireFormat String?
  position    Int       @default(0) // ordre d'affichage manuel (drag & drop admin)
  createdAt   DateTime  @default(now())
  products    Product[]
}

// Saisons (ex: "Printemps/Été 2026", "Automne/Hiver 2025") — scopées par tenant
model Season {
  id                   String              @id @default(cuid())
  name                 String
  pfsRef               String?
  efashionCollectionId Int?
  // Mapping Microstore : ID saison côté MC Gérant. Rempli manuellement via
  // CustomSelect dans SeasonEditorModal. Priorité sur matching par nom au push.
  microstoreSeasonId   Int?
  position             Int                 @default(0)
  createdAt            DateTime            @default(now())
  products             Product[]
  translations         SeasonTranslation[]

  // Multi-tenant : lib scopée par tenant depuis 2026-07-12
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model SeasonTranslation {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  locale    String
  name      String
  createdAt DateTime @default(now())

  @@unique([seasonId, locale])
}

// Bibliothèque de compositions (matériaux) — scopée par tenant
model Composition {
  id                      String                   @id @default(cuid())
  name                    String
  pfsCompositionRef       String?
  // Salesforce Uid PFS (globalement stable, immunisé aux fautes d'orthographe
  // et aux renommages côté PFS). Rempli à la volée par le fallback mobile
  // via le dictionnaire /attributes/composition, et par backfill sur les
  // compos existantes. Match prioritaire par Uid dans resolvePfsCompositionsToLocal.
  pfsCompositionUid       String?
  efashionId              Int?
  faireMaterialLabel      String?
  // Mapping Orderchamp : un des ~35 codes bijoux de l'enum `FilterMaterialValue`
  // (ex "STAINLESS_STEEL", "GOLD_PLATED", "ENAMEL"). Sélectionné par l'admin
  // dans /admin/compositions. Envoyé en `filterMaterial` sur chaque variante
  // au publish. Max 4 matériaux par produit, triés par % décroissant.
  orderchampMaterialCode  String?
  // Mapping Microstore : ID composition côté MC Gérant. Rempli manuellement via
  // CustomSelect dans CompositionEditorModal. Priorité sur matching par nom au push.
  microstoreCompositionId Int?
  position                Int                      @default(0)
  createdAt               DateTime                 @default(now())
  products                ProductComposition[]
  translations            CompositionTranslation[]

  // Multi-tenant : lib scopée par tenant depuis 2026-07-12
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@unique([tenantId, pfsCompositionUid])
  @@index([tenantId])
}

model CompositionTranslation {
  id            String      @id @default(cuid())
  compositionId String
  composition   Composition @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  locale        String
  name          String
  createdAt     DateTime    @default(now())

  @@unique([compositionId, locale])
}

// Liaison produit ↔ composition avec pourcentage
model ProductComposition {
  id            String      @id @default(cuid())
  productId     String
  compositionId String
  percentage    Float // ex: 85.5 pour 85.5%
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  composition   Composition @relation(fields: [compositionId], references: [id], onDelete: Cascade)

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([productId, compositionId])
  @@index([tenantId])
}

// Tags (mots-clés pour recherche) — scopés par tenant
model Tag {
  id           String           @id @default(cuid())
  name         String
  products     ProductTag[]
  translations TagTranslation[]
  createdAt    DateTime         @default(now())

  // Multi-tenant : lib scopée par tenant depuis 2026-07-12
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TagTranslation {
  id        String   @id @default(cuid())
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  locale    String
  name      String
  createdAt DateTime @default(now())

  @@unique([tagId, locale])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@id([productId, tagId])
  @@index([tenantId])
}

// Produit principal
model Product {
  id                          String                           @id @default(cuid())
  reference                   String
  name                        String
  description                 String                           @db.Text
  note                        String?                          @db.Text
  categoryId                  String
  category                    Category                         @relation(fields: [categoryId], references: [id])
  subCategories               SubCategory[]                    @relation("ProductSubCategories")
  // Sous-catégorie choisie pour la colonne "Catégorie" de l'export Microstore.
  // null = catégorie principale (comportement par défaut).
  microstoreSubCategoryId     String?
  microstoreSubCategory       SubCategory?                     @relation("ProductMicrostoreSubCategory", fields: [microstoreSubCategoryId], references: [id], onDelete: SetNull)
  colors                      ProductColor[]
  colorImages                 ProductColorImage[]
  compositions                ProductComposition[]
  collections                 CollectionProduct[]
  collectionExclusions        CollectionExclusion[]
  favorites                   Favorite[]
  tags                        ProductTag[]
  translations                ProductTranslation[]
  catalogs                    CatalogProduct[]
  pfsOrderItems               PfsOrderItem[]
  efashionOrderItems          EfashionOrderItem[]
  ankorstoreOrderItems        AnkorstoreOrderItem[]
  faireOrderItems             FaireOrderItem[]
  orderchampOrderItems        OrderchampOrderItem[]
  microstoreOrderItems        MicrostoreOrderItem[]
  adminCardPurchases          AdminClientCardProductPurchase[]
  isBestSeller                Boolean                          @default(false)
  status                      ProductStatus                    @default(OFFLINE)
  isIncomplete                Boolean                          @default(false) // Produit incomplet (manque prix, poids, images, etc.)
  // Verrou manuel : quand true, le bouton « Rafraîchir » est désactivé pour ce
  // produit (boutique + marketplaces). Sert à protéger une fiche fragile ou en
  // attente d'arbitrage commercial. Indépendant du statut et des syncs.
  locked                      Boolean                          @default(false)
  // Marqueur « Important » côté admin — équivalent d'un favori partagé entre
  // tous les comptes ADMIN. Sert à mettre de côté rapidement une fiche
  // (étoile sur la ligne, filtre « Importants seulement » dans la liste,
  // option de tri « Importants d'abord »). N'est pas exposé côté public.
  important                   Boolean                          @default(false)
  // Produits similaires (M2M self)
  similarProducts             ProductSimilar[]                 @relation("PSim_A")
  similarTo                   ProductSimilar[]                 @relation("PSim_B")
  // Composition produit (ensemble → sous-produits)
  bundleChildren              ProductBundle[]                  @relation("Bundle_Parent")
  bundleParents               ProductBundle[]                  @relation("Bundle_Child")
  // Dimensions optionnelles (en mm)
  dimensionLength             Float?
  dimensionWidth              Float?
  dimensionHeight             Float?
  dimensionDiameter           Float?
  dimensionCircumference      Float?
  // Code SH (Système Harmonisé) — relation vers la bibliothèque HsCode.
  // SetNull : si le code de la bibliothèque est supprimé, le produit perd
  // simplement son code SH.
  hsCodeId                    String?
  hsCode                      HsCode?                          @relation(fields: [hsCodeId], references: [id], onDelete: SetNull)
  // Code ISO alpha-2 du pays de fabrication (ex: "CN"). Mapping marketplaces
  // (refs PFS/eFashion/Faire) figé dans `lib/countries.ts`.
  countryIsoCode              String?
  seasonId                    String?
  season                      Season?                          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  // Couleur principale du produit (vue par défaut côté boutique + default_color PFS).
  // Pointe vers une couleur de la liste des variantes OU des packLines.
  primaryColorId              String?
  primaryColor                Color?                           @relation("ProductPrimaryColor", fields: [primaryColorId], references: [id], onDelete: SetNull)
  // Notice à afficher en bannière quand le système a auto-promu la couleur
  // principale (suite à image manquante / mapping PFS absent / variante supprimée /
  // toutes variantes désactivées). Reset à null quand l'utilisatrice ferme la
  // bannière ou quand une sauvegarde laisse la principale dans un état valide.
  primaryColorPromotionNotice Json?
  lowStockThreshold           Int?
  discountPercent             Decimal?                         @db.Decimal(5, 2) // Remise en % (ex: 15.00 = -15%). null = pas de remise
  views                       ProductView[]
  promotions                  PromotionProduct[]
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  lastRefreshedAt             DateTime? // Date du dernier "Rafraîchir" (remet en Nouveauté sans toucher createdAt)

  sizeDetailsTu String? // Détail taille unique (ex: "52-56"), champ texte libre envoyé à PFS

  // Identifiant marketplace — renseigné à la publication live (null = pas publié)
  pfsProductId String?

  // Marque PFS sous laquelle le produit est référencé. Renseigné à la création
  // (publish/refresh) à partir de la marque sélectionnée dans les paramètres,
  // ou à l'import depuis la réponse PFS (chaque produit liste sa brand).
  // Jamais modifié sur PATCH : la marque d'un produit publié est verrouillée.
  // Si null = marque inconnue (vieux produit publié avant cette fonctionnalité).
  pfsBrandId   String?
  pfsBrandName String?

  // Instantané JSON du dernier état envoyé à PFS — sert à diffuser uniquement
  // les changements lors du prochain "Enregistrer" (skip pfsTranslate/update,
  // patch variantes seulement si modifiées, upload image seulement si changée).
  pfsLastSyncSnapshot Json?

  // Résultat de la dernière vérification PFS (bouton « Vérifier » du panneau
  // Marketplaces). `pfsCheckStatus` = "ok" si aucun écart, "diff" sinon.
  // `pfsCheckIssues` contient la liste structurée des écarts pour le tooltip
  // (fiche produit + couleurs + variantes en trop côté PFS). null tant que
  // la vérification n'a pas été lancée.
  pfsCheckedAt   DateTime?
  pfsCheckStatus String?
  pfsCheckIssues Json?

  // Ankorstore — identifiants et snapshot de la dernière sync réussie
  ankorsProductId        String?
  ankorsLastSyncSnapshot Json?
  ankorsLastRefreshedAt  DateTime?
  marketplaceRefreshJobs MarketplaceRefreshJob[]
  efashionShootingBatch  EfashionShootingBatchItem?
  imageProcessingJobs    ImageProcessingJob[]
  microstoreUploadJobs   MicrostoreUploadJob[]

  // eFashion Paris — chaque couleur du produit BJ correspond à 1 "produit-couleur"
  // chez eFashion (cf. docs/efashion-api.md). On stocke ici la référence partagée
  // entre toutes les couleurs (= reference_base côté eFashion) ainsi que le snapshot
  // de la dernière sync pour diffuser uniquement les changements.
  efashionReferenceBase    String?
  efashionLastSyncSnapshot Json?
  efashionLastRefreshedAt  DateTime?

  // Faire — marketplace B2B (cf. docs/faire-api.md). Auth via clé API simple
  // (X-FAIRE-ACCESS-TOKEN). `faireProductId` = "p_xxx" attribué par Faire à la
  // création. Snapshot pour le diff incrémental, même pattern que PFS.
  faireProductId        String?
  faireLastSyncSnapshot Json?
  faireLastRefreshedAt  DateTime?

  // Orderchamp — marketplace B2B GraphQL (cf. docs/orderchamp-integration.md).
  // Auth Bearer token privé. `orderchampProductId` = ID GraphQL attribué à la
  // création. Snapshot pour le diff incrémental, même pattern que Faire.
  orderchampProductId        String?
  orderchampLastSyncSnapshot Json?
  orderchampLastRefreshedAt  DateTime?

  // Microstore (Dokkr) — depuis 2026-08-25, on utilise POST /goods/add (create)
  // + POST /goods/update (modif) au lieu du CSV /goods/import_v1. `/goods/add`
  // retourne un `id` numérique qu'on persiste dans `microstoreProductId` pour
  // ensuite piloter update/delete-variant proprement (via `del_id` sur
  // /goods/update). Le CSV historique reste utilisable en fallback tant que le
  // backfill n'est pas terminé sur tous les produits déjà poussés.
  microstoreProductId        Int?
  microstoreLastSyncSnapshot Json?
  microstoreLastPushedAt     DateTime?
  /// True si les photos du produit ont bougé depuis le dernier envoi photos
  /// Microstore réussi. Set true par : worker images (image-queue), updateProduct
  /// quand colorImages change, linkMicrostoreProductManually, demande explicite
  /// de resync. Reset false uniquement après push photos réussi. Défaut true
  /// pour forcer un premier alignement sur l'existant après déploiement.
  microstorePhotosDirty      Boolean   @default(true)

  // Drapeaux "Synchronisation nécessaire" — passés à true quand un changement
  // local n'a pas été propagé au marketplace correspondant (save sans cocher
  // la case marketplace dans la modale de save, ou ajout d'image en arrière-plan).
  // Remis à false par les actions de refresh/update marketplace, ou par le X
  // d'annulation dans le badge. Toujours false si le produit n'est pas lié au
  // marketplace en question.
  pfsSyncRequired        Boolean @default(false)
  ankorsSyncRequired     Boolean @default(false)
  efashionSyncRequired   Boolean @default(false)
  faireSyncRequired      Boolean @default(false)
  orderchampSyncRequired Boolean @default(false)
  microstoreSyncRequired Boolean @default(false)

  // Drapeaux "Marketplace activée pour ce produit" — la cliente peut décocher un
  // marketplace dans la fiche produit pour l'exclure de toutes les actions
  // automatiques (publish/refresh/resync/stock). Défaut true = toujours actif.
  // Quand false, le badge apparaît barré + tooltip "Marketplace désactivée" et
  // toutes les modales de push filtrent ce marketplace.
  pfsEnabled        Boolean @default(true)
  ankorsEnabled     Boolean @default(true)
  efashionEnabled   Boolean @default(true)
  faireEnabled      Boolean @default(true)
  orderchampEnabled Boolean @default(true)
  microstoreEnabled Boolean @default(true)

  // Dernier export Excel/ZIP réussi depuis /admin/produits → bouton « Exporter ».
  // Mis à jour automatiquement quand la cliente télécharge l'export ; null = jamais
  // exporté. Pour Microstore, cet export Excel manuel reste disponible en
  // parallèle du push API (microstoreLastPushedAt) — les deux usages coexistent.
  pfsLastExportedAt        DateTime?
  efashionLastExportedAt   DateTime?
  microstoreLastExportedAt DateTime?
  ankorstoreLastExportedAt DateTime?
  faireLastExportedAt      DateTime?
  orderchampLastExportedAt DateTime?

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL après backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, reference])
  @@unique([tenantId, pfsProductId])
  @@unique([tenantId, ankorsProductId])
  @@unique([tenantId, faireProductId])
  @@unique([tenantId, orderchampProductId])
  @@unique([tenantId, microstoreProductId])
  // Performance indexes for 78k+ products
  @@index([tenantId]) // multi-tenant scoping
  // Index composites préfixés par tenantId : couvrent les listings admin
  // filtrés par statut et triés par date. Sans ça, MySQL doit d'abord filtrer
  // par tenantId (injecté par l'extension) puis merger un second index sur
  // (status, createdAt) — beaucoup plus lent à volume élevé.
  @@index([tenantId, status, createdAt])
  @@index([tenantId, status, updatedAt])
  @@index([status, createdAt]) // catalog listing (default sort)
  @@index([status, updatedAt]) // "new" filter sort
  @@index([status, lastRefreshedAt]) // "new" filter including refreshed products
  @@index([categoryId, status]) // category filter
  @@index([isBestSeller, status]) // bestseller filter
  @@index([important, createdAt]) // « Important » filter + sort
  @@index([status, name]) // search by name
  @@index([createdAt]) // general date sorting
  @@index([reference]) // exact reference search
  @@index([countryIsoCode]) // country filter
  @@index([seasonId]) // season filter
  @@index([primaryColorId])
  @@index([pfsLastExportedAt])
  @@index([efashionLastExportedAt])
  @@index([microstoreLastExportedAt])
  @@index([ankorstoreLastExportedAt])
  @@index([faireLastExportedAt])
  @@index([orderchampLastExportedAt])
  @@index([tenantId, efashionReferenceBase]) // NON unique : plusieurs produits BJ (1 par couleur) peuvent partager la même reference_base eFashion
}

// AnkorstoreOperation supprimé le 2026-08-13 : le mode callback-only OAuth2 est
// remplacé par le back-office reverse (synchrone). Plus de suivi d'opération.

// ─────────────────────────────────────────────
// File de rafraîchissement marketplace — pilotée côté serveur (temps réel)
// La row est créée par l'API enqueue, traitée par un worker singleton démarré
// dans instrumentation-node.ts, et consommée par le widget admin qui poll
// /api/admin/marketplace-queue toutes les 2s. Permet à l'utilisatrice de
// recharger la page ou de quitter le navigateur sans perdre la file en cours.
// ─────────────────────────────────────────────
enum MarketplaceJobTarget {
  PFS
  ANKORSTORE
  EFASHION
  FAIRE
  ORDERCHAMP
  MICROSTORE
}

enum MarketplaceJobMode {
  PUBLISH
  REFRESH
  RESYNC
  /// Masque le produit côté marketplace (visible → invisible) sans supprimer la fiche.
  /// Utilisé actuellement uniquement par Microstore (microstoreDisableGoods).
  DISABLE
  /// Réaffiche un produit précédemment masqué. Symétrique de DISABLE.
  ENABLE
  /// Supprime définitivement la fiche côté marketplace + oublie l'ID côté BJ.
  /// Utilisé actuellement uniquement par Microstore (microstoreDeleteGoods).
  DELETE
}

/// Intention métier d'un job. Sert au widget marketplaces à trier chaque job
/// dans la bonne vue (Création / Modification / Rafraîchissement / Étalement).
/// Posé à l'enqueue :
///  - CREATE     : première publication (aucun ID marketplace connu)
///  - UPDATE     : mise à jour d'une fiche déjà liée (PATCH incrémental)
///  - SYNC       : resynchronisation forcée (mode RESYNC : badge orange, bouton ↻ resync)
///  - REFRESH    : renouvellement (archive + recréation, mode REFRESH standard)
///  - SCHEDULED  : rafraîchissement planifié (étalement via scheduledFor)
///  - LINK       : job né d'un flow de liaison manuelle (import/sync post-link)
enum MarketplaceJobIntent {
  CREATE
  UPDATE
  SYNC
  REFRESH
  SCHEDULED
  LINK
}

enum MarketplaceJobStatus {
  QUEUED // en attente du worker
  IN_PROGRESS // en cours de traitement par le worker
  AWAITING_CALLBACK // Ankorstore en mode callback : kickoff envoyé, on attend le webhook
  SUCCEEDED // terminé sans erreur
  FAILED // terminé avec une erreur côté marketplace
  CANCELLED // annulé par l'admin (bouton Stop) avant le démarrage
}

model MarketplaceRefreshJob {
  id                String                @id @default(cuid())
  productId         String
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace       MarketplaceJobTarget
  mode              MarketplaceJobMode
  /// { reference, productName, firstImage, options } figés au enqueue pour l'affichage
  payload           Json
  status            MarketplaceJobStatus  @default(QUEUED)
  /// TargetOutcome sérialisé (forme identique côté client) ou null
  localOutcome      Json?
  pfsOutcome        Json?
  ankorsOutcome     Json?
  efashionOutcome   Json?
  faireOutcome      Json?
  orderchampOutcome Json?
  microstoreOutcome Json?
  /// Intention métier (Création / Modification / Rafraîchissement / Étalement / Liaison).
  /// Résolue à l'enqueue (voir lib/marketplace-job-intent.ts). Sert au widget
  /// marketplaces à router chaque job vers l'onglet correspondant. Nullable
  /// tant que la migration progressive n'a pas backfillé les anciens jobs :
  /// une valeur absente est traitée comme "UPDATE" par défaut côté client.
  intent            MarketplaceJobIntent?
  /// Progression étape par étape (array de StepEntry sérialisé, voir
  /// lib/marketplace-job-steps.ts). Poussée par le worker au fur et à mesure
  /// (Validation → Auth → Création produit → Variantes → Images → Publish →
  /// Sauvegarde IDs). Utilisée par le widget pour afficher la timeline
  /// détaillée style modale de liaison.
  steps             Json?
  /// Opération Ankorstore liée quand status == AWAITING_CALLBACK (suit la chaîne 2 phases)
  ankorsOperationId String?
  errorMessage      String?               @db.Text
  createdAt         DateTime              @default(now())
  /// Heure à laquelle le job peut être démarré. Null = immédiat.
  /// Utilisé pour étaler un lot de rafraîchissements (1 produit toutes les N min).
  scheduledFor      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status]) // file d'attente par tenant (widget marketplace + worker)
  @@index([status])
  @@index([productId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, scheduledFor])
}

// ─────────────────────────────────────────────
// eFashion — liste d'attente du ticket de shooting partagé
// ─────────────────────────────────────────────
// Chez eFashion, une création ou un refresh de produit déclenche la création
// d'un "ticket de shooting" validé manuellement par leur staff. Sans groupage,
// chaque produit envoyé seul = 1 ticket → spam de tickets côté eFashion. Cette
// table stocke les produits en attente d'être envoyés en un seul shooting.
// L'utilisatrice valide manuellement (bouton "Valider le shooting") pour
// déclencher l'envoi groupé. La table survit aux restarts (persistée en MySQL).
//
// `mode` est figé à l'ajout (PUBLISH ou REFRESH) : si l'utilisatrice ré-ajoute
// le produit, la ligne est mise à jour (mode + addedAt rafraîchis). Au moment
// de la validation, le code re-vérifie si le produit est lié ou non pour
// dispatcher entre publish et refresh.
enum EfashionShootingBatchMode {
  PUBLISH
  REFRESH
}

model EfashionShootingBatchItem {
  id        String                    @id @default(cuid())
  productId String                    @unique
  product   Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  mode      EfashionShootingBatchMode
  addedAt   DateTime                  @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([addedAt])
}

// ─────────────────────────────────────────────
// Traitement images en arrière-plan
// ─────────────────────────────────────────────
// Quand l'utilisatrice upload N images (ex : 92 d'un coup), le client envoie
// chaque fichier au serveur qui stocke le buffer brut sur disque et insère un
// job ici, puis retourne IMMÉDIATEMENT. Le worker `lib/image-queue.ts`
// (singleton globalThis) picore les jobs PENDING et appelle
// `processProductImage` (sharp → 3 formats WebP) en parallèle limité.
//
// Résilience : au boot Node (`instrumentation.ts`), tout job PENDING ou
// PROCESSING est repris. Les fichiers bruts sur disque restent jusqu'au DONE
// puis sont supprimés. Jobs FAILED gardent l'erreur pour Retry depuis le widget.
//
// Quand le dernier job PENDING d'un produit lié à PFS/Ankorstore/eFashion
// passe à DONE, on positionne les flags `*SyncRequired = true`.
enum ImageJobStatus {
  PENDING // attend dans la file
  PROCESSING // sharp en cours
  DONE // traité avec succès, fichier brut supprimé
  FAILED // erreur — voir `error`
}

model ImageProcessingJob {
  id          String         @id @default(cuid())
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Fichier brut sur disque, supprimé à la fin (PROCESSING → DONE).
  // Path absolu côté serveur, hors public/.
  rawPath     String
  // Dossier cible (forme productImageDir, ex "uploads/produits/e310b")
  destDir     String
  // Basename sans extension (ex "e310b-doré-1-abc123")
  filename    String
  // Chemin BDD final (ex "/uploads/produits/e310b/e310b-doré-1-abc123.webp")
  // Connu dès l'enqueue pour que la BDD puisse référencer l'image immédiatement.
  dbPath      String
  status      ImageJobStatus @default(PENDING)
  error       String?        @db.Text
  createdAt   DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Snapshot d'affichage pour le widget « Images » — évite de re-résoudre
  // la couleur / le produit à chaque poll UI. `reference` est le Product.reference
  // au moment de l'enqueue (peut différer plus tard si le produit est renommé,
  // mais on veut voir ce qui a réellement été demandé), `colorHex` /
  // `colorPatternImage` reprennent la palette de la couleur choisie
  // (patternImage prioritaire), `position` = index 1-based demandé.
  reference         String?
  colorName         String?
  colorHex          String?
  colorPatternImage String?
  position          Int?

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status, createdAt]) // worker : pick PENDING par ordre d'arrivée
  @@index([productId, status]) // UI : compteur de jobs en cours pour un produit
  @@index([createdAt]) // purge des vieux DONE/FAILED
}

// ─────────────────────────────────────────────
// Microstore — file d'affichage de l'upload d'images
// ─────────────────────────────────────────────
// L'envoi de photos vers Microstore (Station de Transfert) est un flux long :
// par produit on lit N photos locales, upload OSS puis 1 PATCH `/api/goods/{id}`.
// Ces jobs ne sont PAS traités par un worker — ils sont créés et mis à jour au
// fil de l'eau par `sendProductPhotosToMicrostore` / `bulkSendPhotosToMicrostore`
// pour donner un feedback X/N dans le widget flottant.
enum MicrostoreUploadJobStatus {
  PENDING // enqueue, envoi pas encore démarré
  UPLOADING // upload OSS des photos en cours
  PATCHING // upload OSS terminé, PATCH /api/goods en cours
  DONE // succès
  FAILED // échec — voir errorMessage
}

model MicrostoreUploadJob {
  id             String                    @id @default(cuid())
  productId      String?
  product        Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Référence produit figée à l'enqueue (survit à un rename côté BJ).
  reference      String
  // Nom produit figé pour affichage widget (null si absent).
  productName    String?
  status         MicrostoreUploadJobStatus @default(PENDING)
  // Total de photos à envoyer (posé au démarrage effectif). 0 = pas encore connu.
  totalImages    Int                       @default(0)
  // Photos envoyées avec succès sur OSS Microstore.
  uploadedImages Int                       @default(0)
  // Photos qui ont échoué à l'upload OSS.
  failedImages   Int                       @default(0)
  errorMessage   String?                   @db.Text
  createdAt      DateTime                  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([productId])
  @@index([status, createdAt])
  @@index([createdAt]) // purge des vieux DONE/FAILED
}

// ── File d'attente des lots de traduction (bouton « Tout traduire ») ─────────
// Chaque job = 1 lot déclenché par l'admin (ex: 42 couleurs). Le worker traite
// les items en série, écrit chaque traduction en BDD dès qu'elle est reçue, et
// expose le mot en cours pour affichage temps réel dans le tiroir.
enum TranslationJobStatus {
  PENDING // attend le worker
  PROCESSING // en cours
  DONE // terminé (peut avoir des erreurs partielles)
  FAILED // erreur bloquante
}

model TranslationJob {
  id                     String               @id @default(cuid())
  // Libellé affiché dans le tiroir (ex: "Couleurs", "Mots-clés").
  section                String
  // Type d'entité — sert au worker pour choisir la table de traductions.
  // Valeurs : color | tag | composition | category | subcategory |
  // manufacturing-country | season | collection | product
  entityType             String
  // Payload : [{id, text}] — texte FR à traduire pour chaque entité.
  items                  Json
  totalCount             Int                  @default(0)
  doneCount              Int                  @default(0)
  errorCount             Int                  @default(0)
  status                 TranslationJobStatus @default(PENDING)
  // Mot actuellement en cours de traduction (pour affichage temps réel).
  currentItemText        String?              @db.Text
  currentItemTranslation String?              @db.Text
  currentLocale          String?
  // Message d'erreur global si status=FAILED.
  error                  String?              @db.Text
  // Timestamp pour cacher du tiroir sans supprimer (audit / retry).
  dismissedAt            DateTime?
  createdAt              DateTime             @default(now())
  startedAt              DateTime?
  completedAt            DateTime?

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status, createdAt]) // worker : pick PENDING par ordre d'arrivée
  @@index([dismissedAt, createdAt]) // UI : liste des jobs actifs
}

// Traductions automatiques des produits
model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String // "en" | "ar"
  name        String
  description String   @db.Text
  // Flag posé quand la cliente a saisi elle-même le nom OU la description dans
  // l'admin (onglet EN de la ProductForm). L'auto-traduction PFS ne doit plus
  // écraser cette entrée : le mot-à-mot était trop souvent bancal (ex. « Robe
  // sans manches » traduite « Dress without sleeves » au lieu de « Sleeveless
  // dress »).
  manualEdit  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([productId, locale])
  @@index([tenantId])
  @@index([productId])
  @@index([locale]) // admin warnings: count by locale
}

// Produits similaires (M2M self-relation)
model ProductSimilar {
  productId String
  similarId String
  product   Product @relation("PSim_A", fields: [productId], references: [id], onDelete: Cascade)
  similar   Product @relation("PSim_B", fields: [similarId], references: [id], onDelete: Cascade)

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@id([productId, similarId])
  @@index([tenantId])
}

// Composition produit (ensemble contient sous-produits, relation directionnelle)
// parent = l'ensemble (ex: parure), child = le sous-produit (ex: collier)
model ProductBundle {
  parentId String
  childId  String
  parent   Product @relation("Bundle_Parent", fields: [parentId], references: [id], onDelete: Cascade)
  child    Product @relation("Bundle_Child", fields: [childId], references: [id], onDelete: Cascade)

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@id([parentId, childId])
  @@index([tenantId])
}

// Deferred similar product links — stores references that don't exist yet at import time.
// Resolved automatically when matching products are created later.
model PendingSimilar {
  id         String   @id @default(cuid())
  productRef String // reference of the source product (already exists)
  similarRef String // reference of the target product (may not exist yet)
  createdAt  DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([productRef, similarRef])
  @@index([tenantId])
  @@index([similarRef])
}

// Variante d'un produit
// UNIT: une couleur + tailles×qty + prix/poids/stock
// PACK: une couleur principale + tailles×qty + packQuantity + prix/poids/stock
//       (ou packLines pour un PACK multi-couleurs — voir PackColorLine)
model ProductColor {
  id                          String                           @id @default(cuid())
  productId                   String
  product                     Product                          @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId                     String? // Couleur (requise en business logic, nullable en DB pour legacy)
  color                       Color?                           @relation(fields: [colorId], references: [id])
  unitPrice                   Decimal                          @db.Decimal(12, 2) // Prix HT (par unité ou par paquet)
  weight                      Float // Poids en kg
  stock                       Int                              @default(0)
  isPrimary                   Boolean                          @default(false)
  saleType                    SaleType // UNIT ou PACK
  packQuantity                Int? // Quantité par paquet (null si UNIT)
  // Tailles avec quantités (UNIT, ou PACK mono-couleur)
  variantSizes                VariantSize[]
  // Lignes couleur×tailles d'un PACK multi-couleurs.
  // Si présentes, elles SUPPLANTENT colorId/variantSizes pour la composition du paquet.
  packLines                   PackColorLine[]
  images                      ProductColorImage[] // Images (UNIT seulement)
  cartItems                   CartItem[]
  collectionOverrides         CollectionProduct[]
  stockMovements              StockMovement[]
  priceHistory                PriceHistory[]
  pfsOrderItems               PfsOrderItem[]
  efashionOrderItems          EfashionOrderItem[]
  ankorstoreOrderItems        AnkorstoreOrderItem[]
  faireOrderItems             FaireOrderItem[]
  orderchampOrderItems        OrderchampOrderItem[]
  microstoreOrderItems        MicrostoreOrderItem[]
  adminCardPurchases          AdminClientCardProductPurchase[]
  disabled                    Boolean                          @default(false) // Masquer côté client sans supprimer
  sku                         String?                          @unique // SKU universel: {ref}_{couleur}_{UNIT|PACK}_{index}
  // Identifiant variante marketplace — renseigné à la publication live
  pfsVariantId                String?
  // Identifiant variante Ankorstore — renseigné à la publication live
  ankorsVariantId             String?
  // Identifiant "produit-couleur" eFashion (1 ligne par couleur côté eFashion).
  // Renseigné lors de la liaison manuelle ou de la publication via shooting.
  efashionProductId           Int?
  // Identifiant variante Faire ("po_xxx") — renseigné à la publication
  faireVariantId              String?
  // Identifiant variante Orderchamp (ID GraphQL) — renseigné à la publication
  orderchampVariantId         String?
  // Mapping PFS secondaire propre à cette variante (override du pfsColorRef de Color).
  // Sert à différencier 2 variantes dont les couleurs partagent le même mapping principal.
  // Doit être différent du pfsColorRef principal de la couleur sélectionnée (validé applicatif).
  pfsColorRefOverride         String?
  // Mapping eFashion secondaire propre à cette variante (override de Color.efashionColorId).
  // Même logique que pfsColorRefOverride, mais avec l'ID entier de la biblio eFashion.
  efashionColorIdOverride     Int?
  // Override du nom de couleur envoyé à Ankorstore pour cette variante précise.
  // null/vide = on envoie Color.name. Rempli = on envoie ce texte tel quel (Ankor n'a pas
  // de bibliothèque de couleurs formelle, le match se fait par nom).
  ankorsColorNameOverride     String?
  // SKU réel envoyé à Ankorstore : {REF}_{COULEUR}_{5 chars aléatoires}.
  // Persisté à la 1re publication et RÉUTILISÉ à chaque update pour que Ankor reconnaisse
  // la même variante. Vidé quand on delete/archive côté Ankor → un futur re-publish
  // regénère un nouveau suffixe (contourne le refus « SKU already assigned » sur produits
  // archivés Ankor).
  ankorsSku                   String?
  // Override du nom de couleur envoyé à Faire pour cette variante précise.
  // null/vide = on envoie Color.name. Rempli = on envoie ce texte tel quel.
  faireColorNameOverride      String?
  // Override du nom de couleur envoyé à Orderchamp pour cette variante précise.
  // null/vide = on envoie Color.name. Rempli = on envoie ce texte tel quel.
  orderchampColorNameOverride String?
  // Identifiant SKU Microstore — renseigné après /goods/add ou /goods/get lors
  // du backfill. Permet de faire des updates ciblés (garder ce SKU) et des
  // suppressions propres (`del_id=[microstoreVariantId]` dans /goods/update).
  microstoreVariantId         Int?
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([productId, colorId])
  @@index([productId, isPrimary])
  @@index([colorId])
  @@index([stock])
  @@index([unitPrice])
  @@index([pfsVariantId])
  @@index([ankorsVariantId])
  @@index([efashionProductId])
  @@index([faireVariantId])
  @@index([orderchampVariantId])
  @@index([microstoreVariantId])
}

// ─────────────────────────────────────────────
// Tailles (bibliothèque globale, indépendante des catégories)
// ─────────────────────────────────────────────

// Bibliothèque de tailles réutilisables (ex: "XS", "S", "17", "Taille unique")
// pfsSizeRef: 1 correspondance Paris Fashion Shop par taille, obligatoire au niveau app.
// Nullable en DB pour permettre la création batch puis mapping différé.
model Size {
  id             String              @id @default(cuid())
  name           String
  position       Int                 @default(0)
  pfsSizeRef     String?
  variantSizes   VariantSize[]
  packLineSizes  PackColorLineSize[]
  stockMovements StockMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Multi-tenant : lib scopée par tenant depuis 2026-07-12
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([pfsSizeRef])
}

// Taille × quantité dans une variante (UNIT ou PACK)
model VariantSize {
  id             String       @id @default(cuid())
  productColorId String
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  sizeId         String
  size           Size         @relation(fields: [sizeId], references: [id])
  quantity       Int          @default(1) // nombre de pièces de cette taille
  pricePerUnit   Decimal?     @db.Decimal(12, 2) // prix par unité (PACK only) — null pour UNIT

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([productColorId, sizeId])
  @@index([tenantId])
  @@index([productColorId])
}

// Ligne d'un PACK multi-couleurs : une couleur incluse dans le pack avec ses tailles
// Ex: Pack tricolore = 1× ligne Rouge (S×2, M×3) + 1× ligne Bleu (M×2) + 1× ligne Noir (L×1)
model PackColorLine {
  id                          String              @id @default(cuid())
  productColorId              String
  productColor                ProductColor        @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  colorId                     String
  color                       Color               @relation(fields: [colorId], references: [id])
  position                    Int                 @default(0) // ordre d'affichage
  sizes                       PackColorLineSize[]
  // Mapping PFS secondaire propre à cette ligne dans ce pack (override de Color.pfsColorRef).
  // Doit être différent du pfsColorRef principal de la couleur sélectionnée (validé applicatif).
  pfsColorRefOverride         String?
  // Override eFashion propre à cette ligne du pack (pendant de pfsColorRefOverride).
  efashionColorIdOverride     Int?
  // Override du nom de couleur envoyé à Ankorstore pour cette ligne du pack.
  // null/vide = on envoie Color.name (pendant de ankorsColorNameOverride sur ProductColor).
  ankorsColorNameOverride     String?
  // Override du nom de couleur envoyé à Faire pour cette ligne du pack.
  faireColorNameOverride      String?
  // Override du nom de couleur envoyé à Orderchamp pour cette ligne du pack.
  orderchampColorNameOverride String?
  createdAt                   DateTime            @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([productColorId, colorId])
  @@index([tenantId])
  @@index([productColorId])
  @@index([colorId])
}

// Taille × quantité à l'intérieur d'une ligne de PACK
model PackColorLineSize {
  id              String        @id @default(cuid())
  packColorLineId String
  packColorLine   PackColorLine @relation(fields: [packColorLineId], references: [id], onDelete: Cascade)
  sizeId          String
  size            Size          @relation(fields: [sizeId], references: [id])
  quantity        Int           @default(1)

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([packColorLineId, sizeId])
  @@index([tenantId])
  @@index([packColorLineId])
}

// Images liées à un variant spécifique (ProductColor)
// productColorId identifie la variante exacte (ex: Doré/Argenté/Or Rose ≠ Doré/Argenté/Or Rose/Vert)
model ProductColorImage {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId        String
  color          Color         @relation(fields: [colorId], references: [id])
  productColorId String?
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  path           String
  order          Int           @default(0)
  createdAt      DateTime      @default(now())

  // Garde-fou : 1 seule image par (productId, colorId, order). Empêche
  // toute future réintroduction de doublons (cf. refonte couleurs niveau produit).

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([productId, colorId, order])
  @@index([tenantId])
  @@index([productId, colorId])
  @@index([productColorId])
}

// ─────────────────────────────────────────────
// Panier & commandes
// ─────────────────────────────────────────────

// Panier persistant en base (un par utilisateur)
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Ligne du panier — liée directement à une variante plate
model CartItem {
  id        String       @id @default(cuid())
  cartId    String
  cart      Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductColor @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([cartId, variantId])
  @@index([tenantId])
  @@index([cartId])
  @@index([variantId]) // variant price change impact queries
}

// ─────────────────────────────────────────────
// Commandes
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING // En attente de traitement (côté admin : "Nouveau")
  VALIDATED // Validée par l'admin — prête à expédier
  SHIPPED // Expédiée
  CANCELLED // Annulée
}

// Avis clients homepage : PENDING → APPROVED/REJECTED via modération admin.
// APPROVED = affiché sur la home. REJECTED = invisible, motif dans moderationNote.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderModificationReason {
  OUT_OF_STOCK // Rupture de stock
  CLIENT_REQUEST // À la demande du client
  COMMERCIAL_GESTURE // Geste commercial (baisse de prix, article ajouté offert)
}

// ─────────────────────────────────────────────
// Stock
// ─────────────────────────────────────────────

enum StockMovementType {
  MANUAL_IN
  MANUAL_OUT
  ORDER
  CANCEL
  RETURN
  IMPORT
}

// ─────────────────────────────────────────────
// Messagerie
// ─────────────────────────────────────────────

enum ConversationType {
  SUPPORT
  CLAIM
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSource {
  APP
  EMAIL
}

// ─────────────────────────────────────────────
// Service Client
// ─────────────────────────────────────────────

enum ClaimStatus {
  OPEN
  CLOSED
}

// ─────────────────────────────────────────────
// Promotions
// ─────────────────────────────────────────────

enum PromotionType {
  CODE
  AUTO
}

enum DiscountKind {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING // deprecated — représenté par scope=SHIPPING + PERCENTAGE 100 depuis 2026-08-11
}

// Portée de la promotion. Détermine sur QUOI la remise s'applique.
// ALL_PRODUCTS : catalogue entier. Une seule promo AUTO active à la fois (garde-fou).
// PRODUCTS / CATEGORIES / COLLECTIONS : sélection ciblée via les tables pivot.
// SHIPPING : sur les frais de port. Une seule promo AUTO active à la fois.
enum PromotionScope {
  ALL_PRODUCTS
  PRODUCTS
  CATEGORIES
  COLLECTIONS
  SHIPPING
}

// Commande validée par le client
model Order {
  id          String      @id @default(cuid())
  orderNumber String // ex: K7X9M2PH (8 chars aléatoires) — unique par tenant (voir @@unique)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  status      OrderStatus @default(PENDING)

  // Snapshot adresse de livraison
  shipLabel     String
  shipFirstName String
  shipLastName  String
  shipCompany   String?
  shipAddress1  String
  shipAddress2  String?
  shipZipCode   String
  shipCity      String
  shipCountry   String

  // Snapshot client
  clientCompany   String
  clientEmail     String
  clientPhone     String
  clientSiret     String?
  clientVatNumber String?

  // Transporteur
  carrierId             String
  carrierName           String
  carrierPrice          Decimal  @db.Decimal(12, 2) // prix EFFECTIF (après remises)
  // Snapshots pour afficher séparément promotion vs remise commerciale livraison en admin.
  // Nullable pour compat historique — fallback affiché.
  carrierBasePrice      Decimal? @db.Decimal(12, 2)
  carrierPromoDiscount  Decimal  @default(0) @db.Decimal(12, 2)
  carrierClientDiscount Decimal  @default(0) @db.Decimal(12, 2)

  // Transporteur privé (alternative aux transporteurs Easy-Express)
  // Quand carrierId === "private_carrier", le client a son propre fournisseur
  // de transport. Soit il fournit un email/téléphone à contacter, soit il joint
  // directement un bordereau d'expédition (PDF/JPG/PNG).
  privateCarrierEmail     String?
  privateCarrierPhone     String?
  privateCarrierBordereau String? // chemin public, ex: /uploads/bordereaux/xyz.pdf

  // Remise commerciale client (snapshot au moment de la commande)
  clientDiscountType  ClientDiscountType?
  clientDiscountValue Decimal?            @db.Decimal(12, 2)
  clientDiscountAmt   Decimal             @default(0) @db.Decimal(12, 2) // montant économisé en €
  clientFreeShipping  Boolean             @default(false)

  // TVA
  tvaRate    Float // ex: 0.20
  subtotalHT Decimal @db.Decimal(12, 2) // HT NET (après promotion + remise commerciale + code)
  tvaAmount  Decimal @db.Decimal(12, 2)
  totalTTC   Decimal @db.Decimal(12, 2)

  // Snapshot du HT BRUT (avant toute réduction) — pour afficher séparément
  // promotion et remise commerciale dans le récap commande. Nullable pour
  // compat commandes historiques ; recalculé au fallback (subtotalHT + clientDiscountAmt + promoDiscount).
  subtotalBrutHT    Decimal? @db.Decimal(12, 2)
  // Somme des promotions AUTO appliquées par item (via règles Promotion) —
  // distinct de promoDiscount qui est le code promo saisi manuellement.
  promoAutoDiscount Decimal  @default(0) @db.Decimal(12, 2)
  // Snapshot JSON des promotions appliquées à la commande.
  // Persiste MÊME si la promotion est supprimée en BDD après.
  // Format : [{ id, name, kind:"AUTO"|"CODE", scope, discountKind, discountValue, amountSaved }]
  appliedPromotions Json?

  // Stripe
  stripePaymentIntentId String? @unique // pi_xxx
  paymentStatus         String  @default("pending") // pending | paid | failed

  // Mode de paiement choisi par le client au checkout.
  // "CARD" = paiement Stripe immédiat (iframe embarquée),
  // "BANK_TRANSFER" = virement (paiement différé, validation manuelle admin),
  // "STRIPE_LINK" = lien Stripe Checkout Session externe — fallback quand
  //   l'iframe est bloquée par le navigateur du client. Commande créée en
  //   PENDING avec paymentStatus="pending" ; passe à "paid" au webhook
  //   checkout.session.completed.
  // Nullable pour compat commandes historiques (traitées comme CARD par défaut à l'affichage).
  paymentMode String? // "CARD" | "BANK_TRANSFER" | "STRIPE_LINK"

  // Horodatage + admin qui a marqué le virement comme reçu (paymentMode=BANK_TRANSFER).
  // Utilisé pour l'audit / historique + pour l'email de confirmation.
  bankTransferConfirmedAt DateTime?
  bankTransferConfirmedBy String?   // User.id de l'admin qui a confirmé

  // Stripe Checkout Session (paymentMode=STRIPE_LINK uniquement).
  // URL et expiration figées à la création ; régénérables via l'action
  // regeneratePaymentLink si le client attend > 24h avant de payer.
  stripeCheckoutSessionId        String?   @unique // cs_xxx
  stripeCheckoutSessionUrl       String?   @db.Text
  stripeCheckoutSessionExpiresAt DateTime?

  // Easy-Express
  eeTrackingId String? // Numéro de suivi
  eeLabelUrl   String? // URL du bordereau PDF @db.Text

  // Smarty365 (alternative à Easy-Express — cf. lib/smarty365.ts)
  smartyParcelId    Int? // id numérique du parcel Smarty365
  smartyTrackingId  String? // trackingNumber renvoyé par Smarty365
  smartyLabelUrl    String? @db.Text // URL S3 signée du bordereau PDF
  smartyTransporter String? // ex "CHRONOPOST" (utilisé pour re-générer si besoin)
  smartyRouteCode   String? // ex "CHRONOPOST_SML_CLASSIC" (route utilisée)

  // Fournisseur d'expédition utilisé pour cette commande (null = historique / manuel)
  shippingProvider String? // "easy_express" | "smarty365"

  // Facture uploadée par l'admin
  invoicePath    String? // Chemin relatif depuis /private/uploads/invoices/
  creditNotePath String? // Avoir PDF uploadé par l'admin

  // CGV acceptance
  cgvAcceptedAt DateTime? // Timestamp when client accepted CGV before payment

  // Consentement remplacement en cas de rupture de stock (case cochée au panier)
  acceptReplacementContact Boolean @default(false)

  // Promotion & credit applied
  promoCode     String?
  promoDiscount Decimal @default(0) @db.Decimal(10, 2)
  creditApplied Decimal @default(0) @db.Decimal(10, 2)

  // Trace de la dernière notification client de modification (rupture / ajustement / ajout)
  clientNotifiedAt DateTime?

  // Sous-total HT payé initialement (immuable, sert au contrôle de dépassement lors
  // des modifications post-commande). Null pour les commandes créées avant l'ajout du champ.
  paidSubtotalHT Decimal? @db.Decimal(12, 2)

  // Fusion vers une commande parente encore en préparation (PENDING) : quand la
  // cliente demande d'ajouter un panier d'appoint à une commande existante, ce
  // champ pointe vers cette commande parente. L'admin traitera la fusion en
  // regroupant les articles + en ajustant le port. `null` = commande autonome.
  mergeIntoOrderId String?
  mergeIntoOrder   Order?  @relation("OrderMerges", fields: [mergeIntoOrderId], references: [id])
  mergedOrders     Order[] @relation("OrderMerges")

  // Relations for new features
  stockMovements    StockMovement[]
  creditUsages      CreditUsage[]
  promotionUsages   PromotionUsage[]
  itemModifications OrderItemModification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL après backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userId, status]) // client order listing with status filter
  @@index([paymentStatus]) // payment status queries
  @@index([createdAt]) // admin order listing
  @@index([userId]) // standalone customer lookup
  @@index([status, createdAt]) // admin filtered + paginated listing
}

// Ligne de commande (snapshot produit au moment de la commande)
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productName String
  productRef  String
  colorName   String // Composition couleur (UNIT) ou vide (PACK — détails dans packDetails)
  saleType    String // "UNIT" | "PACK"
  packQty     Int?
  size        String? // Ancien champ — conservé pour compatibilité historique
  sizesJson   String? @db.Text // JSON: [{name, quantity}] — tailles avec quantités
  packDetails String? @db.Text // JSON: PACK color lines [{colors: [name], ...}]
  imagePath   String? // première image (relatif /public)

  unitPrice Decimal @db.Decimal(12, 2) // prix unitaire calculé (remise incluse)
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)

  // Remise ligne admin, indépendante du prix unitaire (baisse du total HT ligne).
  // type = "percent" | "fixed" ; amt = montant € calculé (cache).
  lineDiscountType  String?
  lineDiscountValue Decimal? @db.Decimal(12, 4)
  lineDiscountAmt   Decimal? @db.Decimal(12, 2)

  variantSnapshot String? @db.Text // JSON: snapshot complet de la variante pour traçabilité légale

  // Article ajouté en compensation post-commande (rupture / geste commercial).
  // false = article initialement commandé par le client, true = ajout admin.
  isCompensation Boolean @default(false)

  // Référence vers la variante originelle (ProductColor.id). Sert au merge
  // d'articles identiques ajoutés successivement en compensation.
  productColorId String?

  modifications OrderItemModification[]

  createdAt DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([productRef]) // bestseller groupBy + reassort queries
}

// Modification d'article de commande (traçabilité)
// Une modification peut concerner la quantité, le prix unitaire, ou les deux.
model OrderItemModification {
  id                String                  @id @default(cuid())
  orderItemId       String
  orderItem         OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originalQuantity  Int
  newQuantity       Int // 0 = rupture totale
  originalUnitPrice Decimal?                @db.Decimal(12, 2) // null = prix inchangé au moment de la 1re modif
  newUnitPrice      Decimal?                @db.Decimal(12, 2) // null = prix inchangé
  reason            OrderModificationReason
  priceDifference   Decimal                 @db.Decimal(12, 2) // montant négatif = avoir dû
  createdAt         DateTime                @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([orderItemId])
}

// ─────────────────────────────────────────────
// Collections
// ─────────────────────────────────────────────

// Collection (ex: "Été 2026", "Romantique", "Minimaliste")
model Collection {
  id           String                  @id @default(cuid())
  name         String
  // Slug URL-friendly dérivé du nom (ex : "eclat-automne-2026"). Sert d'URL
  // publique `/collections/[slug]` — plus lisible que le cuid pour SEO et
  // partage. Nullable pendant migration progressive puis backfillé.
  slug         String?
  image        String? // Chemin relatif depuis /public
  products     CollectionProduct[]
  translations CollectionTranslation[]
  promotions   PromotionCollection[]
  rule         CollectionRule?
  exclusions   CollectionExclusion[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// Marqueur origine d'un produit dans une collection.
// AUTO   = ajouté par une règle, ressort si le produit ne matche plus.
// MANUAL = ajouté ou épinglé à la main, reste tant qu'on ne le retire pas.
enum CollectionProductSource {
  AUTO
  MANUAL
}

// Règle de peuplement automatique d'une collection. 1 collection → 0 ou 1 règle.
// Toutes les conditions sont combinées en ET. À l'intérieur d'un champ multi-valeurs
// (categoryIds, subCategoryIds, tagIds), le OU est implicite.
// `compositions` = tableau [{ compositionId, minPercent? }] tous ET'és.
model CollectionRule {
  id                 String     @id @default(cuid())
  collectionId       String     @unique
  collection         Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  seasonId           String?
  categoryIds        Json? // string[]
  subCategoryIds     Json? // string[]
  tagIds             Json? // string[]
  compositions       Json? // Array<{ compositionId: string; minPercent?: number }>
  lastRecalculatedAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Exclusion manuelle : un produit qui matche la règle mais qu'on ne veut PAS dans la collection.
model CollectionExclusion {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  excludedAt   DateTime   @default(now())
  excludedById String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([collectionId, productId])
  @@index([tenantId])
  @@index([productId])
}

model CollectionTranslation {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  locale       String
  name         String
  createdAt    DateTime   @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([collectionId, locale])
  @@index([tenantId])
}

// Liaison produit ↔ collection avec couleur et ordre d'affichage
model CollectionProduct {
  id            String                  @id @default(cuid())
  collectionId  String
  collection    Collection              @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId       String? // Couleur à afficher dans cette collection (null = couleur primaire)
  productColor  ProductColor?           @relation(fields: [colorId], references: [id])
  position      Int                     @default(0)
  source        CollectionProductSource @default(MANUAL)
  addedByRuleAt DateTime? // horodatage entrée automatique par la règle
  createdAt     DateTime                @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([collectionId, productId])
  @@index([tenantId])
  @@index([collectionId])
}

// Adresse de livraison (plusieurs par utilisateur)
model ShippingAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // ex: "Boutique principale"
  firstName String
  lastName  String
  company   String?
  address1  String
  address2  String?
  zipCode   String
  city      String
  country   String   @default("FR")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Catalogues partageables
// ─────────────────────────────────────────────

enum CatalogStatus {
  INACTIVE // Désactivé (non accessible via lien)
  ACTIVE // Activé (accessible via lien)
}

model Catalog {
  id        String           @id @default(cuid())
