  @@index([tenantId])
}

model LegalDocumentVersion {
  id                  String        @id @default(cuid())
  documentId          String
  document            LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content             String        @db.LongText
  companyInfoSnapshot String        @db.LongText // JSON snapshot of CompanyInfo at time of save
  changeNote          String? // e.g. "Modification manuelle" or "Mise à jour infos société"
  createdAt           DateTime      @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([documentId, createdAt])
}

