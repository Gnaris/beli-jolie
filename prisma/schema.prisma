  quantity     Int
  reason       ClaimItemReason
  reasonDetail String?         @db.Text

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([claimId])
}

model ClaimImage {
