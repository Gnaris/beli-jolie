// ─────────────────────────────────────────────
// CustomerReview — avis clients affichés sur la homepage.
// 1 seul avis par client (userId @unique) — note 1-5 + paragraphe libre.
// Nouveau brouillon = PENDING (invisible). Admin approuve → APPROVED
// (publié) ou rejette → REJECTED (invisible, motif dans moderationNote).
// Un mail pro (SiteConfig[smtp_from_email]) est envoyé à l'admin dès qu'un
// nouvel avis PENDING est déposé.
// Éligibilité côté serveur : le client doit avoir ≥ 1 Order avec status
// SHIPPED dans le tenant courant (vérif dans `assertCanSubmitReview`).
// ─────────────────────────────────────────────
model CustomerReview {
  id             String       @id @default(cuid())
  // 1 seul avis par client. Un User appartient à 1 seul tenant (@@unique(tenantId, email))
  // donc @unique sur userId est équivalent à @@unique([tenantId, userId]).
  userId         String       @unique
  user           User         @relation("CustomerReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  rating         Int // 1..5 (validation applicative — pas de check contrainte MySQL)
  text           String       @db.Text // paragraphe libre (max 1200 char côté validation applicative)
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  moderatedAt    DateTime?
  moderatedById  String?
  moderatedBy    User?        @relation("CustomerReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderationNote String? // Motif interne visible admin uniquement (ex : "hors sujet", "propos inappropriés")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([moderatedById])
}

// ─────────────────────────────────────────────
// Historique des mails semi-automatiques envoyés depuis /admin/utilisateurs
// (Vue Mails). Alimente les 4 colonnes de dates + les avertissements
// contextuels (« déjà envoyé il y a X »).
//
// scenarioKey est un String libre (pas d'enum) pour rester flexible :
// - "ABANDONED_CART"
// - "INACTIVE_CLIENT"
// - "NEWSLETTER"
// - "RESTOCK"
// - futures clés au besoin (ex. campagnes ciblées)
// ─────────────────────────────────────────────
model EmailSend {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientEmail String      @db.VarChar(320)
  fromEmail      String?     @db.VarChar(320)
  fromName       String?     @db.VarChar(200)
  scenarioKey    String      @db.VarChar(50)
  subject        String      @db.VarChar(500)
  htmlBody       String?     @db.LongText
  textBody       String?     @db.Text
  sentAt         DateTime    @default(now())
  status         String      @default("SENT") @db.VarChar(10) // SENT | FAILED
  errorMessage   String?     @db.Text
  messageId      String?     @db.VarChar(500)
  attempts       Int         @default(1)
  resendOfId     String?
  resendOf       EmailSend?  @relation("EmailResend", fields: [resendOfId], references: [id], onDelete: SetNull)
  resends        EmailSend[] @relation("EmailResend")
  metadata       Json?

  @@index([tenantId, userId, sentAt])
  @@index([tenantId, userId, scenarioKey, sentAt])
  @@index([tenantId, scenarioKey, sentAt])
  @@index([tenantId, status, sentAt])
}

// ─────────────────────────────────────────────
// Modèles de newsletter réutilisables.
// La cliente compose plusieurs modèles à l'avance (« Nouveautés d'automne »,
// « Nouvelle collection X »…) puis choisit lequel envoyer au moment de
// cliquer « Envoyer newsletter » sur une sélection de clients.
//
// blocks = tableau JSON des blocs éditeur (banner/heading/products/…) avec
// leur configuration. Rendu HTML côté serveur au moment de l'envoi.
// ─────────────────────────────────────────────
model NewsletterTemplate {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(200) // Nom interne (ex. « Nouveautés d'automne 2026 »)
  subject     String    @db.VarChar(500) // Sujet du mail (ex. « ✨ Découvrez nos nouveautés »)
  blocks      Json      @default("[]") // Structure des blocs de l'éditeur
  // Si posé, ce modèle est le modèle actif d'un scénario transactionnel
  // (ABANDONED_CART, INACTIVE_CLIENT, RESTOCK). Un seul modèle par scénario
  // par tenant. Non supprimable tant que ce champ est posé.
  // Note panier abandonné : seul le Stage 1 porte scenarioKey="ABANDONED_CART".
  // Les Stages 2+ ont scenarioKey=null mais sont protégés via FK
  // AbandonedCartStage.templateId (voir relation `abandonedCartStage`).
  scenarioKey String?   @db.VarChar(40)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSentAt  DateTime? // Dernière fois qu'un envoi a utilisé ce modèle

  abandonedCartStage  AbandonedCartStage?
  inactiveClientStage InactiveClientStage?

  @@unique([tenantId, scenarioKey])
  @@index([tenantId, updatedAt])
}

// ─────────────────────────────────────────────
// File d'envoi groupé d'une newsletter à des fiches clients (AdminClientCard).
// Alimente le widget « Envoi de mails » du rail admin — chaque job affiche
// ligne par ligne le statut d'envoi (attente/en cours/envoyé/échoué + msg).
//
// Flux :
//   1. FicheNewsletterBulkBar POST /admin/marketing → server action crée le
//      BulkMailJob PENDING avec `recipients` initialisé à l'état WAITING.
//   2. Worker `lib/bulk-mail-worker.ts` prend le job, passe à RUNNING, envoie
//      les mails un par un avec 300 ms de délai (anti-spam ISP), met à jour
//      chaque recipient (SENDING → SENT/FAILED) au fil de l'eau.
//   3. Widget poll `/api/admin/bulk-mail-jobs` toutes les 2 s pour l'UI live.
//   4. Job COMPLETED (ou FAILED en cas d'erreur globale). Reste 5 min dans le
//      widget après complétion, puis peut être dismiss (soft-hide).
//
// `recipients` = tableau JSON de BulkMailRecipient (voir types côté lib).
// ─────────────────────────────────────────────
enum BulkMailJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model BulkMailJob {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Snapshot du modèle utilisé — permet l'affichage même si le modèle a été
  // renommé/supprimé après l'envoi. Le templateId reste pour le lien vers la
  // fiche modèle (peut être null si le modèle a été supprimé).
  templateId      String?
  templateName    String  @db.VarChar(200)
  templateSubject String  @db.VarChar(500)

  // JSON [{ficheId, email, name, status: "WAITING"|"SENDING"|"SENT"|"FAILED", error?, sentAt?}]
  recipients Json

  totalCount  Int
  sentCount   Int @default(0)
  failedCount Int @default(0)

  status       BulkMailJobStatus @default(PENDING)
  errorMessage String?           @db.Text

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  // Timestamp pour cacher du widget sans supprimer (audit / retry).
  dismissedAt DateTime?

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────
// Stades de relance panier abandonné.
// La cliente configure N stades (1, 2, 3…). Chaque stade a un délai (en
// secondes depuis la dernière mutation panier) et un template mail dédié.
// Contraintes applicatives (server actions) : délais strictement croissants,
// stageIndex commence à 1 sans trou, chaque template contient {unsubscribeLink}
// dans son contenu (footer désinscription obligatoire pour l'envoi).
// Suppression d'un stade → cascade delete du template lié (`onDelete: Cascade`
// côté templateId) pour rester propre : l'utilisatrice l'a validé le
// 2026-09-09 (« Supprime avec pour être plus propre »).
// ─────────────────────────────────────────────
model AbandonedCartStage {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stageIndex   Int // 1-based, ordre du stade (1 = premier envoi)
  delaySeconds Int // délai depuis la dernière mutation panier avant envoi
  templateId   String   @unique
  template     NewsletterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, stageIndex])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Job actif de relance panier pour un client.
// Un unique job par (tenant, user) : upsert à chaque mutation panier
// (add/remove/qty/size/color). Reset le timer du prochain stade non-envoyé,
// n'efface JAMAIS `stagesFired` (règle validée : un stade envoyé ne se
// rejoue pas, même si le client vide/remplit le panier).
// Passé à CANCELLED sur commande créée, panier vidé, opt-out, ou stade max
// atteint. Worker `abandoned-cart-worker.ts` poll toutes les 10s :
// SELECT WHERE status="PENDING" AND nextStageAt <= now().
// ─────────────────────────────────────────────
model AbandonedCartJob {
  id     String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dernier stade envoyé avec succès (0 = aucun envoi encore).
  // La règle « ne jamais rejouer un stade déjà envoyé » repose sur ce champ.
  currentStage    Int      @default(0)
  // Historique JSON : [{stageIndex, sentAt, emailSendId}].
  stagesFired     Json     @default("[]")
  // Date planifiée du prochain envoi. null si :
  //  - status != "PENDING", OU
  //  - tous les stades disponibles ont été envoyés (jusqu'à ce que la
  //    cliente ajoute un stade supérieur → recalcul via upsert au prochain
  //    mouvement panier).
  nextStageAt     DateTime?
  status          String   @default("PENDING") @db.VarChar(20)
  // PENDING | COMPLETED (tous stades envoyés) | CANCELLED (commande / opt-out / panier vidé)

  // Dernière mutation panier détectée : sert de point de référence pour
  // recalculer `nextStageAt` = lastCartUpdateAt + stage.delaySeconds.
  lastCartUpdateAt DateTime
  // Dernière évaluation par le worker (debug).
  lastEvaluatedAt  DateTime?
  // Cause de dernier CANCELLED / COMPLETED (debug côté admin).
  cancelReason     String?  @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, nextStageAt])
  @@index([tenantId, userId])
}

// ─────────────────────────────────────────────
// Config des stades de relance inactivité (miroir strict de
// AbandonedCartStage). Un stade = un délai en secondes depuis la dernière
// activité du client (max(lastSeenAt, lastOrderAt, createdAt)) + un modèle
// de mail dédié. Suppression d'un stade = cascade delete du template lié.
// ─────────────────────────────────────────────
model InactiveClientStage {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stageIndex   Int // 1-based, ordre du stade (1 = premier envoi)
  delaySeconds Int // délai depuis referenceAt (max lastSeen/lastOrder/createdAt) avant envoi
  templateId   String   @unique
  template     NewsletterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, stageIndex])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Job actif de relance inactivité pour un client.
// Un unique job par (tenant, user). Contrairement au panier abandonné, on ne
// pose PAS nextStageAt à l'avance (le worker recalcule à chaque tick à
// partir de referenceAt = max(lastSeenAt, lastOrderAt, createdAt)).
// stagesFired mémorise ce qui a été envoyé pour éviter les doublons.
// Wipé automatiquement au démarrage d'un nouveau cycle (referenceAt plus
// récent que le dernier sentAt de stagesFired).
// ─────────────────────────────────────────────
model InactiveClientJob {
  id     String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dernier stade envoyé avec succès (0 = aucun envoi encore dans le cycle courant).
  currentStage Int  @default(0)
  // Historique JSON : [{stageIndex, sentAt, emailSendId}]. Wipé au reset de cycle.
  stagesFired  Json @default("[]")
  // PENDING | COMPLETED (tous stades envoyés) | CANCELLED (opt-out, non-APPROVED, désinscrit)
  status       String @default("PENDING") @db.VarChar(20)

  // Référence temporelle utilisée pour calculer le prochain envoi. Recalculée
  // par le worker à chaque tick : max(lastSeenAt, lastOrderAt, createdAt).
  referenceAt     DateTime?
  // Dernière évaluation par le worker (debug + throttling anti-boucle).
  lastEvaluatedAt DateTime?
  // Cause de dernier CANCELLED / COMPLETED (debug côté admin).
  cancelReason    String?  @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, userId])
}

// ─────────────────────────────────────────────
// Résultats détaillés d'un audit PFS.
// Une ligne = un écart ou une erreur trouvé pendant l'audit.
// Le state agrégé (compteurs) vit dans SiteConfig[pfs_audit_state] ;
// les écarts détaillés vivent ici pour scaler à des dizaines de milliers
// de produits sans faire exploser la case JSON de SiteConfig (TEXT = 64 Ko max).
// À chaque nouveau démarrage d'audit, les lignes du run précédent sont supprimées.
// ─────────────────────────────────────────────
model PfsAuditResult {
  id           String    @id @default(cuid())
  tenantId     String
  auditRunId   String
  productId    String
  reference    String
  name         String    @db.Text
  firstImage   String?   @db.Text
  ok           Boolean
  issues       Json?
  errorMessage String?   @db.Text
  errorKind    String?
  createdAt    DateTime  @default(now())
  // Posé quand la cliente clique « Ignorer » ou après une correction réussie —
  // le drawer filtre sur dismissedAt=null pour ne pas ressusciter les cartes
  // au refresh. Quand tout est dismissed, l'audit est reset côté serveur.
  dismissedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, auditRunId])
  @@index([tenantId, auditRunId, dismissedAt])
}

// Journal historique des runs d'audit PFS (manuel ou automatique).
// Une ligne par exécution complète. `autoTriggered=true` = lancé par le
// scheduler (SiteConfig `pfs_audit_auto_enabled`) ; false = déclenché par un
// clic humain. Purge auto après 90 jours (voir purgeOldPfsAuditRuns).
model PfsAuditRun {
  id              String   @id @default(cuid())
  tenantId        String
  autoTriggered   Boolean  @default(false)
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  // "RUNNING" | "DONE" | "ERROR"
  status          String
  totalProducts   Int      @default(0)
  changedProducts Int      @default(0)
  errorMessage    String?  @db.Text

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changes PfsAuditRunChange[]

  @@index([tenantId, startedAt])
  @@index([tenantId, finishedAt])
}

// Une ligne par produit touché lors d'un run. Le tableau JSON `changes`
// contient un item par champ modifié : { scope, field, colorRef?, variantType?,
// colorName?, before, after, label }. Rendu en tableau avant/après côté drawer.
model PfsAuditRunChange {
  id         String   @id @default(cuid())
  runId      String
  tenantId   String
  productId  String
  reference  String
  name       String   @db.Text
  firstImage String?  @db.Text
  changes    Json
  createdAt  DateTime @default(now())

  run    PfsAuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([tenantId, createdAt])
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  host      String   @unique // "beliandjolie.com", "www.beliandjolie.com", "issyma.com"…
  isPrimary Boolean  @default(false) // Le domaine canonique de la boutique (celui affiché dans les mails, sitemap…)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
