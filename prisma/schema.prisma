// ─────────────────────────────────────────────
// Configuration du site (clé/valeur)
// ─────────────────────────────────────────────

model SiteConfig {
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  // Multi-tenant : PK composite (tenantId, key) — chaque boutique a sa config.
  // Écritures : passer par `setSiteConfig` / `unsetSiteConfig` (lib/site-config-write.ts)
  // qui utilisent updateMany+create pour rester compatibles avec l'extension
  // d'auto-scoping.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
}

// ─────────────────────────────────────────────
// Tokens de réinitialisation de mot de passe
// ─────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([token])
}

// ─────────────────────────────────────────────
// Code OTP pour connexion sans mot de passe
// ─────────────────────────────────────────────

model LoginOtp {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email, createdAt])
}

// ─────────────────────────────────────────────
// Sécurité — Code OTP pour actions destructives sur produits
// (suppression, rafraîchissement, archivage). Le mail arrive
// sur l'adresse pro configurée en Paramètres > Société.
// ─────────────────────────────────────────────

model AdminActionOtp {
  id         String    @id @default(cuid())
  adminId    String // User.id de l'admin qui a déclenché l'action
  action     String // "delete" | "refresh" | "archive"
  productIds Json // Liste des ID produits concernés (string[])
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([adminId, createdAt])
}

// ─────────────────────────────────────────────
// Sécurité — Tentatives de connexion (brute force)
// ─────────────────────────────────────────────

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String // Email tenté
  ip        String // Adresse IP
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Verrouillage progressif par email
// Multi-tenant : unique composite (tenantId, email) — un compteur d'échecs par
// boutique. Sinon un même email présent sur 2 tenants provoque un mismatch
// à l'upsert (deux boutiques totalement étanches côté visiteur).
// tenantId reste nullable côté Prisma pour cohérence avec le reste du schema
// (l'extension prisma-tenant-scope l'injecte à runtime).
model AccountLockout {
  id           String    @id @default(cuid())
  email        String
  failureCount Int       @default(0) // Nombre total d'échecs consécutifs
  lockoutLevel Int       @default(0) // Palier actuel (0=pas verrouillé, 1=1min, 2=5min, ...)
  lockedUntil  DateTime? // Null = pas verrouillé
  permanent    Boolean   @default(false) // Blocage définitif
  updatedAt    DateTime  @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

// ─────────────────────────────────────────────
// Sécurité — Log d'inscription (anti-spam)
// ─────────────────────────────────────────────

model RegistrationLog {
  id        String   @id @default(cuid())
  ip        String
  email     String
  phone     String
  siret     String?
  company   String
  createdAt DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([ip, createdAt])
  @@index([phone, createdAt])
  @@index([siret, createdAt])
  @@index([email, createdAt])
}

// ─────────────────────────────────────────────
// Import en masse (produits & images)
// ─────────────────────────────────────────────

enum ImportDraftType {
  PRODUCTS
  IMAGES
  PFS_IMPORT
}

enum ImportDraftStatus {
  PENDING
  RESOLVED
}

enum ImportJobStatus {
  PENDING
  UPLOADING // Images: batches still being uploaded
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model ImportJob {
  id             String          @id @default(cuid())
  type           ImportDraftType
  status         ImportJobStatus @default(PENDING)
  filename       String?
  totalItems     Int             @default(0) // total rows or images to process
  processedItems Int             @default(0) // processed so far
  successItems   Int             @default(0)
  errorItems     Int             @default(0)
  filePath       String? // saved CSV/Excel path on server
  tempDir        String? // temp dir for images
  errorDraftId   String? // link to ImportDraft if errors
  errorMessage   String?         @db.Text // global error message if FAILED
  resultDetails  Json? // detailed log of what was created/imported
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  adminId        String
  admin          User            @relation(fields: [adminId], references: [id])

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

model ImportDraft {
  id          String            @id @default(cuid())
  type        ImportDraftType
  status      ImportDraftStatus @default(PENDING)
  filename    String?
  totalRows   Int               @default(0)
  successRows Int               @default(0)
  errorRows   Int               @default(0)
  rows        Json // Array of rows with errors + metadata
  tempDir     String? // For image drafts: temp directory path
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  adminId     String
  admin       User              @relation(fields: [adminId], references: [id])

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([adminId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Quota de traduction (DeepL + Google)
// ─────────────────────────────────────────────

model TranslationQuota {
  id        String   @id @default(cuid())
  provider  String // "deepl" | "google"
  monthYear String // "2026-03" format
  charsUsed Int      @default(0)
  maxChars  Int // 500000
  updatedAt DateTime @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
