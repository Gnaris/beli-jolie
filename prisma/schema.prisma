// Ligne du panier — liée directement à une variante plate
model CartItem {
  id        String       @id @default(cuid())
  cartId    String
  cart      Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductColor @relation(fields: [variantId], references: [id], onDelete: Cascade)
