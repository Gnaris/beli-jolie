// ─────────────────────────────────────────────
// File des retours en stock à notifier — pilotée manuellement par l'admin.
// Chaque fois qu'une variante passe de stock=0 à stock>0, on crée un
// enregistrement `dispatchedAt=null`. L'admin voit le compteur dans le
// widget flottant et clique "Envoyer les notifications" quand il souhaite.
// Le dispatch groupe par client (Favorites) et envoie 1 seul email récap
// listant tous les produits favorisés qui viennent de repasser en stock.
// ─────────────────────────────────────────────
model RestockEvent {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productColorId String
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  occurredAt     DateTime     @default(now())
  dispatchedAt   DateTime? // null = en attente

  @@index([tenantId, dispatchedAt])
  @@index([tenantId, productId])
  @@index([productColorId])
}

model LegalDocument {
  id        String                 @id @default(cuid())
  type      LegalDocumentType      @unique
  title     String
  content   String                 @db.LongText // HTML with {{variable}} placeholders
  isActive  Boolean                @default(true)
  versions  LegalDocumentVersion[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
