  shippingLabel  String?
  adminNote      String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Avoirs (Credits SAV)
// ─────────────────────────────────────────────

model Credit {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  remainingAmount Decimal       @db.Decimal(10, 2)
  claimId         String?
  claim           Claim?        @relation(fields: [claimId], references: [id])
  expiresAt       DateTime?
  usages          CreditUsage[]
  createdAt       DateTime      @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([claimId])
}

model CreditUsage {
  id        String   @id @default(cuid())
  creditId  String
  credit    Credit   @relation(fields: [creditId], references: [id])
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([creditId])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// Promotions
// ─────────────────────────────────────────────

model Promotion {
  id             String                @id @default(cuid())
  name           String
  type           PromotionType
  code           String?               @unique
  discountKind   DiscountKind
  discountValue  Decimal               @db.Decimal(10, 2)
  minOrderAmount Decimal?              @db.Decimal(10, 2)
  maxUses        Int?
  maxUsesPerUser Int?
  firstOrderOnly Boolean               @default(false)
  appliesToAll   Boolean               @default(true)
  startsAt       DateTime
  endsAt         DateTime?
  isActive       Boolean               @default(true)
  currentUses    Int                   @default(0)
  categories     PromotionCategory[]
  collections    PromotionCollection[]
  products       PromotionProduct[]
  usages         PromotionUsage[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([type, isActive])
  @@index([code])
  @@index([startsAt, endsAt])
}

model PromotionCategory {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([promotionId, categoryId])
  @@index([tenantId])
}

model PromotionCollection {
  id           String     @id @default(cuid())
  promotionId  String
  promotion    Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([promotionId, collectionId])
  @@index([tenantId])
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([promotionId, productId])
  @@index([tenantId])
}

model PromotionUsage {
  id              String    @id @default(cuid())
  promotionId     String
  promotion       Promotion @relation(fields: [promotionId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  discountApplied Decimal   @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([promotionId])
  @@index([userId])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// Product Analytics
// ─────────────────────────────────────────────

model ProductView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation("ProductViewer", fields: [userId], references: [id])
  sessionId String
  createdAt DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([productId, createdAt])
  @@index([productId, sessionId, createdAt])
}

model PriceHistory {
  id             String       @id @default(cuid())
  productColorId String
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  field          String
  oldPrice       Decimal      @db.Decimal(10, 2)
  newPrice       Decimal      @db.Decimal(10, 2)
  changedById    String
  changedBy      User         @relation("PriceChanger", fields: [changedById], references: [id])
  createdAt      DateTime     @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([productColorId, createdAt])
}

// ─────────────────────────────────────────────
// Visites du site (anonymes + connectés)
// ─────────────────────────────────────────────
// Une ligne par visiteur unique par jour. Un visiteur connecté est identifié
// par son userId, un visiteur anonyme par un cookie aléatoire (`bj_visitor_id`).
// Le couple visitorId+date est unique → un rafraîchissement de page ou plusieurs
// pages visitées dans la même journée ne dupliquent pas le compteur.
model Visit {
  id              String   @id @default(cuid())
  visitorId       String // userId si connecté, sinon UUID stocké en cookie
  isAuthenticated Boolean  @default(false)
  date            String // Format YYYY-MM-DD (UTC simplifié pour l'agrégation)
  createdAt       DateTime @default(now())

  // Multi-tenant : nullable pendant migration progressive, deviendra NOT NULL apres backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([visitorId, date])
  @@index([tenantId])
  @@index([date])
  @@index([isAuthenticated, date])
}

// ─────────────────────────────────────────────
// Multi-tenant : chaque boutique cliente = un Tenant.
// La résolution runtime se fait via TenantDomain.host (req.headers.host).
// Un Tenant peut avoir plusieurs domaines (apex + www + éventuel alias).
// ─────────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // "beli-jolie", "issyma"… (utilisé pour uploads/{slug}/…)
  name      String // Nom affiché ("Beli & Jolie")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains      TenantDomain[]
  users        User[]
  products     Product[]
  orders       Order[]
  companyInfos CompanyInfo[]

  productTranslations        ProductTranslation[]
  productColors              ProductColor[]
  productColorImages         ProductColorImage[]
  productSimilars            ProductSimilar[]
  productBundles             ProductBundle[]
  productTags                ProductTag[]
  productCompositions        ProductComposition[]
  productViews               ProductView[]
  priceHistorys              PriceHistory[]
  carts                      Cart[]
  cartItems                  CartItem[]
  visits                     Visit[]
  pendingSimilars            PendingSimilar[]
  orderItems                 OrderItem[]
  orderItemModifications     OrderItemModification[]
  favorites                  Favorite[]
  shippingAddresss           ShippingAddress[]
  claims                     Claim[]
  claimItems                 ClaimItem[]
  claimImages                ClaimImage[]
  claimReturns               ClaimReturn[]
  claimReships               ClaimReship[]
  credits                    Credit[]
  creditUsages               CreditUsage[]
  collections                Collection[]
  collectionTranslations     CollectionTranslation[]
  collectionProducts         CollectionProduct[]
  promotions                 Promotion[]
  promotionCategorys         PromotionCategory[]
  promotionCollections       PromotionCollection[]
  promotionProducts          PromotionProduct[]
  promotionUsages            PromotionUsage[]
  catalogs                   Catalog[]
  catalogProducts            CatalogProduct[]
  importJobs                 ImportJob[]
  importDrafts               ImportDraft[]
  restockAlerts              RestockAlert[]
  ankorstoreOperations       AnkorstoreOperation[]
  marketplaceRefreshJobs     MarketplaceRefreshJob[]
  efashionShootingBatchItems EfashionShootingBatchItem[]
  imageProcessingJobs        ImageProcessingJob[]
  translationJobs            TranslationJob[]
  stockMovements             StockMovement[]
  legalDocuments             LegalDocument[]
  legalDocumentVersions      LegalDocumentVersion[]
  conversations              Conversation[]
  messages                   Message[]
  messageAttachments         MessageAttachment[]
  passwordResetTokens        PasswordResetToken[]
  loginOtps                  LoginOtp[]
  loginAttempts              LoginAttempt[]
  accountLockouts            AccountLockout[]
  registrationLogs           RegistrationLog[]
  translationQuotas          TranslationQuota[]
  stripeWebhookEvents        StripeWebhookEvent[]
  variantSizes               VariantSize[]
  packColorLines             PackColorLine[]
  packColorLineSizes         PackColorLineSize[]
  SiteConfig                 SiteConfig[]

  @@index([isActive])
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  host      String   @unique // "beliandjolie.com", "www.beliandjolie.com", "issyma.com"…
  isPrimary Boolean  @default(false) // Le domaine canonique de la boutique (celui affiché dans les mails, sitemap…)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
