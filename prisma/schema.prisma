  faireOrders     FaireOrder[]
  faireOrderItems FaireOrderItem[]

  microstoreOrders     MicrostoreOrder[]
  microstoreOrderItems MicrostoreOrderItem[]

  emailScenarios    EmailScenario[]
  emailSends        EmailSend[]
  emailUnsubscribes EmailUnsubscribe[]
  restockEvents     RestockEvent[]

  pfsAuditResults PfsAuditResult[]

  @@index([isActive])
}

// ─────────────────────────────────────────────
// Résultats détaillés d'un audit PFS.
// Une ligne = un écart ou une erreur trouvé pendant l'audit.
// Le state agrégé (compteurs) vit dans SiteConfig[pfs_audit_state] ;
// les écarts détaillés vivent ici pour scaler à des dizaines de milliers
// de produits sans faire exploser la case JSON de SiteConfig (TEXT = 64 Ko max).
// À chaque nouveau démarrage d'audit, les lignes du run précédent sont supprimées.
// ─────────────────────────────────────────────
model PfsAuditResult {
  id           String    @id @default(cuid())
  tenantId     String
  auditRunId   String
  productId    String
  reference    String
  name         String    @db.Text
  firstImage   String?   @db.Text
  ok           Boolean
  issues       Json?
  errorMessage String?   @db.Text
  errorKind    String?
  createdAt    DateTime  @default(now())
  // Posé quand la cliente clique « Ignorer » ou après une correction réussie —
  // le drawer filtre sur dismissedAt=null pour ne pas ressusciter les cartes
  // au refresh. Quand tout est dismissed, l'audit est reset côté serveur.
  dismissedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, auditRunId])
  @@index([tenantId, auditRunId, dismissedAt])
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  host      String   @unique // "beliandjolie.com", "www.beliandjolie.com", "issyma.com"…
  isPrimary Boolean  @default(false) // Le domaine canonique de la boutique (celui affiché dans les mails, sitemap…)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Configuration par scénario (activé/pause + délais + réglages)
// Un seul enregistrement par (tenant, key).
// `config` (Json) contient les réglages spécifiques :
//   ABANDONED_CART → { reminders: [{ afterHours: 24 }, { afterHours: 72 }] }
//   BACK_IN_STOCK  → {}  (déclenché à la mise en stock, pas de délai)
//   WELCOME        → {}
//   NEWSLETTER     → {}
// ─────────────────────────────────────────────
model EmailScenario {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       EmailScenarioKey
  enabled   Boolean          @default(false) // Par défaut désactivé — la cliente doit l'activer explicitement
  config    Json             @default("{}")
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Historique d'envoi (dédup + stats + tracking)
// `dedupKey` permet d'éviter les doublons : ex. "cart:<userId>:stage-0" pour
// la 1re relance panier de ce user, "back-in-stock:<productColorId>:<userId>"
// pour retour en stock. Unique par (tenantId, scenarioKey, dedupKey).
// ─────────────────────────────────────────────
model EmailSend {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenarioKey    EmailScenarioKey
  recipientEmail String
  userId         String? // Renseigné si envoi lié à un compte existant
  subject        String           @db.VarChar(500)
  dedupKey       String           @db.VarChar(300) // Clé anti-doublon (voir commentaire ci-dessus)
  sentAt         DateTime         @default(now())
  openedAt       DateTime? // Rempli par le pixel de tracking (1er open)
  clickedAt      DateTime? // Rempli par la 1re redirection cliquée
  unsubscribedAt DateTime? // Rempli si ce destinataire s'est désabonné après cet email
  messageId      String? // Message-ID SMTP renvoyé par nodemailer
  metadata       Json? // { cartId, productId, productColorId, stage: 0|1… }

  @@unique([tenantId, scenarioKey, dedupKey])
  @@index([tenantId])
  @@index([tenantId, sentAt])
  @@index([tenantId, scenarioKey])
  @@index([recipientEmail])
}

// ─────────────────────────────────────────────
// Désinscriptions par scope (RGPD).
// MARKETING_ALL = super-scope qui coupe les 3 autres.
// ─────────────────────────────────────────────
model EmailUnsubscribe {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String                @db.VarChar(320)
  scope     EmailUnsubscribeScope
  createdAt DateTime              @default(now())

  @@unique([tenantId, email, scope])
  @@index([tenantId])
  @@index([email])
}
